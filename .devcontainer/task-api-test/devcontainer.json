{
  "name": "TaskAPI 12: Testes e deploy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "workspaceFolder": "/workspaces/devlab/examples/courses/expressjs/projects/task-api-test",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install && cp -n .env.example .env && npm run db:migrate && npm run db:seed",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "Servidor": "npm run dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["src/routes/task-router.test.ts"]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": ["humao.rest-client"]
    }
  }
}
