{
  "name": "MonitorApp 4: Validação",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "workspaceFolder": "/workspaces/devlab/examples/courses/express/projects/monitor-app-validation",
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "API (Express)",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Front (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd back && npm install && cd front && npm install",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "API": "cd back && npm run dev",
    "Front": "cd front && npm run dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["back/src/schemas/host.schema.ts", "front/index.html"]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": ["humao.rest-client", "biomejs.biome"]
    }
  }
}
