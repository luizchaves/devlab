{
  "name": "TaskAPI 5: Valida\u00e7\u00e3o",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "workspaceFolder": "/workspaces/devlab/examples/courses/expressjs/projects/task-api-validation",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "Servidor": "npm run dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["src/schemas/task.ts"]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": ["humao.rest-client"]
    }
  }
}
