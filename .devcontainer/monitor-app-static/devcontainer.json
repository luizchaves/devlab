{
  "name": "MonitorApp 1: Front estático",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "workspaceFolder": "/workspaces/devlab/examples/courses/express/projects/monitor-app-static",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Front (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd front && npm install",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "Front": "cd front && npm run dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["front/index.html", "front/css/tailwind.css"]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": ["humao.rest-client", "biomejs.biome"]
    }
  }
}
