{
  "name": "InvestFlow React",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "workspaceFolder": "/workspaces/devlab/examples/courses/react/investflow-react",
  "forwardPorts": [3000, 54341, 54343],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "openPreview"
    },
    "54341": {
      "label": "Supabase API"
    },
    "54343": {
      "label": "Supabase Studio"
    }
  },
  "postCreateCommand": "corepack enable && npm install -g supabase && pnpm install && pnpm exec playwright install --with-deps chromium && cp -n .env.example .env",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "App": "supabase start && pnpm db:migrate && pnpm db:seed && pnpm dev --hostname 0.0.0.0"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/(public)/page.tsx", "src/server/auth.ts"]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": ["dbaeumer.vscode-eslint", "Prisma.prisma", "ms-playwright.playwright"]
    }
  }
}
