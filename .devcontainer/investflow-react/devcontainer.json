{
  "name": "InvestFlow React",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "workspaceFolder": "/workspaces/devlab/examples/courses/react/investflow-react",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "corepack enable && pnpm install && pnpm exec playwright install --with-deps chromium",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "App": "pnpm dev --hostname 0.0.0.0"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/page.tsx", "src/features/portfolio/portfolio-dashboard.tsx"]
    },
    "vscode": {
      "settings": { "git.autoRepositoryDetection": false },
      "extensions": ["dbaeumer.vscode-eslint", "Prisma.prisma", "ms-playwright.playwright"]
    }
  }
}
