{
  "name": "Express: Prisma",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "workspaceFolder": "/workspaces/devlab/examples/express/projects/prisma",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install && cp .env.example .env && npm run db:push && npm run db:seed",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "Servidor": "npm run dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "prisma/schema.prisma"
      ]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": [
        "humao.rest-client",
        "prisma.prisma",
        "qwtel.sqlite-viewer"
      ]
    }
  }
}
