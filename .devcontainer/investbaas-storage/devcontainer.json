{
  "name": "InvestBaaS 5: Armazenamento de comprovantes",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "workspaceFolder": "/workspaces/devlab/examples/courses/npm/projects/investbaas-storage",
  "forwardPorts": [5173, 54321, 54323],
  "portsAttributes": {
    "5173": { "label": "Front (Vite)", "onAutoForward": "openPreview" },
    "54321": { "label": "Supabase API" },
    "54323": { "label": "Supabase Studio" }
  },
  "postCreateCommand": "npm install -g supabase && npm install && npx playwright install --with-deps chromium",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "Supabase": "supabase start && supabase status -o env",
    "Front": "npm run dev -- --host"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/services/auth.js",
        "supabase/migrations/20260912000001_profiles.sql"
      ]
    },
    "vscode": {
      "settings": { "git.autoRepositoryDetection": false },
      "extensions": ["biomejs.biome", "ms-playwright.playwright"]
    }
  }
}
