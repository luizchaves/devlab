{
  "name": "InvestBaaS 1: Frontend estático",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "workspaceFolder": "/workspaces/devlab/examples/courses/npm/projects/investbaas-static",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Front (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install",
  "waitFor": "postCreateCommand",
  "postAttachCommand": {
    "Front": "npm run dev -- --host"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["index.html", "docs/SPRINTS.md"]
    },
    "vscode": {
      "settings": {
        "git.autoRepositoryDetection": false
      },
      "extensions": ["biomejs.biome"]
    }
  }
}
