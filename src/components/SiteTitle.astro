---
import { getCourse } from '@lib/courses';
import { withBase } from '@lib/site';

const { entry, siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const course = getCourse(entry.data.course);
---

<div class="site-title sl-flex">
  <a href={siteTitleHref} class="site-link" translate="no">
    <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
    <span>{siteTitle}</span>
  </a>
  {
    course && (
      <>
        <span class="separator" aria-hidden="true">/</span>
        <a href={withBase(course.href)} class="course-link" translate="no">
          {course.title}
        </a>
      </>
    )
  }
</div>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: 0.35rem;
      font-size: var(--sl-text-h4);
      font-weight: 600;
      white-space: nowrap;
      min-width: 0;
    }

    a {
      color: var(--sl-color-text-accent);
      text-decoration: none;
    }

    .site-link,
    .course-link {
      display: inline-flex;
      align-items: center;
    }

    a:hover,
    a:focus {
      color: var(--sl-color-white);
    }

    .site-link {
      flex-shrink: 0;
      gap: 0.45rem;
    }

    .brand-mark {
      display: inline-grid;
      place-items: center;
      width: 1.55rem;
      height: 1.55rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 72%, transparent);
      border-radius: 0.4rem;
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--sl-color-accent) 28%, transparent), transparent),
        var(--sl-color-bg-nav);
      color: var(--sl-color-text-accent);
      font-size: 0.68rem;
      font-weight: 800;
      line-height: 1;
    }

    .separator {
      color: var(--sl-color-gray-3);
      font-weight: 400;
      font-size: 0.9em;
    }

    .course-link {
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }
  }
</style>
