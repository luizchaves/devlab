---
/**
 * `<FileTree>` — arvore de arquivos escrita como texto.
 *
 * Camada sobre o `<FileTree>` nativo do Starlight (icones por extensao,
 * dark/light mode e acessibilidade vem dele). A diferenca e a API: em vez de
 * escrever listas HTML/Markdown aninhadas, a arvore e escrita exatamente como
 * aparece no terminal.
 *
 * ```mdx
 * <FileTree>
 * {`
 * src/
 * ├── app.js
 * ├── routes/
 * │   └── user-router.js
 * └── controllers/
 *     └── user-controller.js
 * `}
 * </FileTree>
 * ```
 *
 * Tambem aceita a arvore pela prop `tree`, util em loops:
 * `<FileTree tree={estrutura} />`.
 *
 * Diretorios sao detectados pela `/` final ou por terem filhos; `**arquivo**`
 * destaca uma entrada e o texto apos o nome vira comentario.
 */
import { FileTree as StarlightFileTree } from '@astrojs/starlight/components';
import { treeTextToHtml } from '../lib/file-tree';

interface Props {
  /** Arvore em texto. Alternativa ao conteudo passado como filho. */
  tree?: string | undefined;
}

const { tree } = Astro.props;
const slotContent = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const source = tree ?? slotContent;

// O slot pode chegar com tags de paragrafo do MDX; so o texto interessa.
const plainText = source
  .replace(/<[^>]+>/g, '')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .replace(/&amp;/g, '&');

const html = treeTextToHtml(plainText);

if (!html) {
  throw new Error('<FileTree> precisa receber uma arvore de arquivos como texto.');
}
---

<StarlightFileTree>
  <Fragment set:html={html} />
</StarlightFileTree>
