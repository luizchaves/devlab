---
/**
 * `<ApiResponse>` — apresenta a resposta HTTP correspondente.
 *
 * ```mdx
 * <ApiResponse status={200}>
 * {`
 * {
 *   "id": 1,
 *   "name": "Ana"
 * }
 * `}
 * </ApiResponse>
 * ```
 */
import { Code } from '@astrojs/starlight/components';
import { slotHtmlToText } from '../lib/slot-text';

interface Props {
  status: number;
  /** Texto do status. Inferido a partir do codigo quando omitido. */
  statusText?: string | undefined;
  /** Texto curto explicando a resposta. */
  description?: string | undefined;
  /** Linguagem do corpo da resposta. Padrao: `json`. */
  lang?: string | undefined;
}

const STATUS_TEXT: Record<number, string> = {
  200: 'OK',
  201: 'Created',
  204: 'No Content',
  301: 'Moved Permanently',
  304: 'Not Modified',
  400: 'Bad Request',
  401: 'Unauthorized',
  403: 'Forbidden',
  404: 'Not Found',
  409: 'Conflict',
  422: 'Unprocessable Entity',
  500: 'Internal Server Error',
};

const STATUS_CLASSES: Record<string, string> = {
  '2xx': 'bg-sl-green',
  '3xx': 'bg-sl-blue',
  '4xx': 'bg-sl-orange',
  '5xx': 'bg-sl-red',
};

const { status, statusText, description, lang = 'json' } = Astro.props;

const rawBody = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const body = slotHtmlToText(rawBody);
const label = statusText ?? STATUS_TEXT[status] ?? '';
const badgeClasses = STATUS_CLASSES[`${Math.floor(status / 100)}xx`] ?? 'bg-sl-gray-4';
---

<div class="api-exchange not-content my-4 overflow-hidden rounded-lg border border-sl-gray-5 bg-sl-black">
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-sl-gray-5 bg-sl-gray-6 px-3.5 py-2.5"
  >
    <span
      class:list={[
        'shrink-0 rounded px-2 py-0.5 font-mono text-sl-xs font-semibold text-sl-white',
        badgeClasses,
      ]}
    >
      {status}
    </span>
    {label && <span class="font-mono text-sl-sm text-sl-white">{label}</span>}
  </div>

  {
    description && (
      <p class="m-0 px-3.5 py-2.5 text-sl-sm text-sl-gray-2 [&+.api-exchange__body]:border-t [&+.api-exchange__body]:border-sl-gray-5">
        {description}
      </p>
    )
  }

  {
    body && (
      <div class="api-exchange__body">
        <Code code={body} lang={lang} frame="none" />
      </div>
    )
  }
</div>

<style>
  @layer starlight.components {
    .api-exchange :global(.expressive-code) {
      margin: 0;
    }

    .api-exchange :global(.expressive-code pre) {
      border: none;
      border-radius: 0;
    }
  }
</style>
