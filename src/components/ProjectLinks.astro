---
/**
 * `<ProjectLinks>` — botoes de acesso ao codigo de um projeto.
 *
 * Toda pagina de projeto deve oferecer dois caminhos: ler o codigo no GitHub e
 * abrir um ambiente pronto no GitHub Codespaces (via `.devcontainer/`).
 *
 * ```mdx
 * <ProjectLinks path="examples/courses/express/projects/mvc" devcontainer="express-mvc" />
 * <ProjectLinks path="examples/courses/express/projects/hello" devcontainer={false} />
 * <ProjectLinks repo="luizchaves/lp2-2026" branch="sqlite" path="classroom/back-end/investment-api" />
 * ```
 *
 * Sem `repo`, os links apontam para o proprio repositorio do DevLab, e a pasta de
 * `.devcontainer/` e deduzida do ultimo segmento de `path`. Com `repo`, o botao do
 * Codespaces abre a branch sem `devcontainer_path`, a menos que `devcontainer` seja
 * informado.
 */
import { Icon } from '@astrojs/starlight/components';
import { REPO_BRANCH, REPO_URL } from '../lib/site';

interface Props {
  /** Caminho do projeto dentro do repositorio, sem barra inicial. */
  path: string;
  /** Repositorio externo no formato `owner/name`. Omita para usar o do DevLab. */
  repo?: string | undefined;
  /** Branch a abrir. Omita para usar a branch padrao do repositorio. */
  branch?: string | undefined;
  /**
   * Pasta em `.devcontainer/`. `false` desativa o botao do Codespaces.
   * Omitido: deduzido de `path` no repositorio do DevLab, ausente em repositorio externo.
   */
  devcontainer?: string | false | undefined;
  /** URL de uma demonstracao publicada, quando existir. */
  preview?: string | undefined;
}

const { path, repo, branch, devcontainer, preview } = Astro.props;

// `https://github.com/<owner>/<repo>` -> `<owner>/<repo>`
const repoSlug = repo ?? REPO_URL.replace(/^https?:\/\/[^/]+\//, '');
const ref = branch ?? (repo ? undefined : REPO_BRANCH);

const cleanPath = path.replace(/^\.?\/|\/+$/g, '');
const githubHref = ref
  ? `https://github.com/${repoSlug}/tree/${ref}/${cleanPath}`
  : `https://github.com/${repoSlug}/tree/main/${cleanPath}`;

const folder = cleanPath.split('/').at(-1) ?? cleanPath;

// Em repositorio externo nao ha como adivinhar a pasta de `.devcontainer/`:
// so vale o valor informado explicitamente.
const devcontainerName = devcontainer ?? (repo ? false : folder);

const codespaceParams = new URLSearchParams();

if (devcontainerName) {
  codespaceParams.set('devcontainer_path', `.devcontainer/${devcontainerName}/devcontainer.json`);
}

if (ref) {
  codespaceParams.set('ref', ref);
}

const query = codespaceParams.toString();
const codespaceHref =
  devcontainerName || repo
    ? `https://codespaces.new/${repoSlug}${query ? `?${query}` : ''}`
    : undefined;

const linkClass =
  'inline-flex items-center gap-1.5 rounded-md border border-sl-gray-5 bg-sl-gray-6 px-3 py-1.5 text-sl-sm text-sl-white no-underline transition-colors hover:border-sl-accent hover:text-sl-accent';
---

<div class="not-content my-4 flex flex-wrap gap-2" aria-label="Acesso ao código do projeto">
  <a href={githubHref} target="_blank" rel="noopener noreferrer" class={linkClass}>
    <Icon name="github" size="1em" />
    Ver no GitHub
  </a>

  {
    codespaceHref && (
      <a href={codespaceHref} target="_blank" rel="noopener noreferrer" class={linkClass}>
        <Icon name="rocket" size="1em" />
        Abrir no Codespaces
      </a>
    )
  }

  {
    preview && (
      <a href={preview} target="_blank" rel="noopener noreferrer" class={linkClass}>
        <Icon name="external" size="1em" />
        Demonstração
      </a>
    )
  }
</div>
