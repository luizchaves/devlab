---
/**
 * `<CodeTabs>` — varios arquivos relacionados em abas.
 *
 * Combina o `<Tabs>` nativo do Starlight com o `<SourceCode>`, portanto cada
 * aba continua sendo um bloco de Expressive Code completo (copiar, titulo,
 * numeros de linha, marcacoes...).
 *
 * ```mdx
 * <CodeTabs
 *   files={[
 *     'examples/express-mvc/src/app.js',
 *     { path: 'examples/express-mvc/src/routes/user-router.js', mark: '5-8' },
 *   ]}
 * />
 * ```
 *
 * Cada item pode ser uma string (o caminho) ou um objeto com todas as props do
 * `<SourceCode>` mais `label`. Sem `label`, o nome do arquivo e usado.
 */
import { TabItem, Tabs } from '@astrojs/starlight/components';
import type { CodeTabFile } from '../lib/source-code';
import { inferFileName } from '../lib/source-files';
import SourceCode from './SourceCode.astro';

interface Props {
  files: Array<string | CodeTabFile>;
  /** Sincroniza a aba selecionada com outros `<Tabs>` que usem a mesma chave. */
  syncKey?: string | undefined;
}

const { files, syncKey } = Astro.props;

const tabs = files.map((file) => {
  const config: CodeTabFile = typeof file === 'string' ? { path: file } : file;
  const { label, ...sourceCodeProps } = config;

  return { label: label ?? inferFileName(config.path), props: sourceCodeProps };
});
---

<Tabs syncKey={syncKey}>
  {
    tabs.map((tab) => (
      <TabItem label={tab.label}>
        <SourceCode {...tab.props} />
      </TabItem>
    ))
  }
</Tabs>
