---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { getCourse } from '@lib/courses';

const { entry, sidebar } = Astro.locals.starlightRoute;
const course = getCourse(entry.data.course);
const firstEntry = sidebar[0];
const sublist =
  course && firstEntry?.type === 'group' && firstEntry.label === course.title
    ? firstEntry.entries
    : sidebar;
---

<SidebarPersister>
  <SidebarSublist sublist={sublist} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
