---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { getCourse } from '@lib/courses';

const { entry, sidebar } = Astro.locals.starlightRoute;
const course = getCourse(entry.data.course);
const courseEntry = course
  ? sidebar.find((item) => item.type === 'group' && item.label === course.title)
  : undefined;
const sublist = courseEntry?.type === 'group' ? courseEntry.entries : sidebar;
---

<SidebarPersister>
  <SidebarSublist sublist={sublist} />
</SidebarPersister>

<script is:inline>
  (() => {
    const openCurrentSidebarGroups = () => {
      const currentLink = document.querySelector(
        'sl-sidebar-state-persist a[aria-current="page"]'
      );

      if (!currentLink) return;

      let parent = currentLink.parentElement;

      while (parent) {
        if (parent instanceof HTMLDetailsElement) {
          parent.open = true;
        }

        if (parent.tagName.toLowerCase() === 'sl-sidebar-state-persist') {
          break;
        }

        parent = parent.parentElement;
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', openCurrentSidebarGroups, { once: true });
    } else {
      openCurrentSidebarGroups();
    }

    document.addEventListener('astro:page-load', openCurrentSidebarGroups);
  })();
</script>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
