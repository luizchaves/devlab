---
/**
 * `<HtmlPreview>` — mostra como o navegador renderiza um arquivo HTML real.
 *
 * ```mdx
 * <HtmlPreview path="examples/html-basics/listas.html" height="18rem" />
 * ```
 *
 * O arquivo e lido em build time (mesma infraestrutura do `<SourceCode>`) e
 * injetado em um iframe totalmente isolado (`sandbox=""`): sem scripts, sem
 * formularios, sem navegacao. O preview mostra a renderizacao padrao do
 * navegador, que e justamente o que se quer ensinar em HTML.
 *
 * Como `srcdoc` nao resolve caminhos relativos, as imagens locais suportadas
 * sao embutidas como `data:` URI.
 */
import { loadSource, readAssetDataUri, resolveRelative } from '../lib/source-files';

interface Props {
  /** Caminho do arquivo, relativo a raiz do projeto. */
  path: string;
  /** Altura do quadro. Padrao: `20rem`. */
  height?: string | undefined;
  /** Rotulo do quadro. Padrao: nome do arquivo. */
  label?: string | undefined;
}

const { path, height = '20rem', label } = Astro.props;

const source = loadSource({ path });

// Embute as imagens locais: em `srcdoc` o caminho relativo nao tem base.
const html = source.code.replace(
  /(\ssrc=")(?!https?:|data:|\/)([^"]+)(")/g,
  (match, before: string, target: string, after: string) => {
    const dataUri = readAssetDataUri(resolveRelative(path, target));
    return dataUri ? `${before}${dataUri}${after}` : match;
  }
);
---

<figure class="html-preview not-content my-4 overflow-hidden rounded-lg border border-sl-gray-5">
  <figcaption
    class="flex items-center gap-2 border-b border-sl-gray-5 bg-sl-gray-6 px-3.5 py-2 text-sl-xs text-sl-gray-2"
  >
    <span class="flex gap-1" aria-hidden="true">
      <span class="block size-2 rounded-full bg-sl-gray-4"></span>
      <span class="block size-2 rounded-full bg-sl-gray-4"></span>
      <span class="block size-2 rounded-full bg-sl-gray-4"></span>
    </span>
    {label ?? source.fileName}
  </figcaption>

  <iframe
    class="block w-full border-0 bg-white"
    style={`height: ${height}`}
    title={`Renderização de ${label ?? source.fileName}`}
    sandbox=""
    loading="lazy"
    srcdoc={html}></iframe>
</figure>
