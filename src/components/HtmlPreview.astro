---
/**
 * `<HtmlPreview>` — mostra como o navegador renderiza um arquivo HTML real.
 *
 * ```mdx
 * <HtmlPreview path="examples/html-basics/listas.html" height="18rem" />
 * ```
 *
 * O arquivo e lido em build time (mesma infraestrutura do `<SourceCode>`) e,
 * por padrao, injetado em um iframe totalmente isolado (`sandbox=""`): sem
 * scripts, sem formularios, sem navegacao. O preview mostra a renderizacao
 * padrao do navegador, que e justamente o que se quer ensinar em HTML.
 *
 * Como `srcdoc` nao resolve caminhos relativos, as imagens locais suportadas
 * sao embutidas como `data:` URI.
 *
 * O diretorio do exemplo e sempre publicado em `public/`, para que o nome do
 * arquivo no cabecalho seja um link que abre a pagina real em outra aba.
 *
 * Para exemplos que precisam de uma URL real tambem dentro do quadro, como
 * links por fragmento, use `serveFromPublic`: nesse modo o iframe usa `src` em
 * vez de `srcdoc`.
 */
import { cpSync, mkdirSync } from 'node:fs';
import { dirname, join, relative, sep } from 'node:path';
import { Icon } from '@astrojs/starlight/components';
import { withBase } from '../lib/site';
import {
  loadSource,
  normalizeSourcePath,
  readAssetDataUri,
  resolveRelative,
} from '../lib/source-files';

interface Props {
  /** Caminho do arquivo, relativo a raiz do projeto. */
  path: string;
  /** Altura do quadro. Padrao: `20rem`. */
  height?: string | undefined;
  /** Rotulo do quadro. Padrao: nome do arquivo. */
  label?: string | undefined;
  /** Usa arquivo publico real em vez de `srcdoc`, para navegacao por links. */
  serveFromPublic?: boolean | undefined;
}

const { path, height = '20rem', label, serveFromPublic = false } = Astro.props;

const source = loadSource({ path });
const normalizedPath = normalizeSourcePath(path);

const projectRoot = process.cwd();

function publicExampleRoot(filePath: string): string {
  const segments = filePath.split('/');

  if (segments[0] === 'examples' && segments[1]) {
    return segments.slice(0, 2).join('/');
  }

  if (segments[0] === 'src' && segments[1] === 'examples' && segments[2]) {
    return segments.slice(0, 3).join('/');
  }

  return dirname(filePath);
}

function shouldCopyPublicPreviewEntry(sourcePath: string, rootPath: string): boolean {
  const parts = relative(rootPath, sourcePath).split(sep).filter(Boolean);
  const blockedDirs = new Set(['node_modules', 'dist', 'build', 'generated', '.prisma', '.git']);

  if (parts.some((part) => blockedDirs.has(part))) return false;
  if (parts.some((part) => part.startsWith('.env'))) return false;
  if (/\.(?:db|db-journal|sqlite|sqlite3)$/i.test(sourcePath)) return false;

  return true;
}

function publishPublicPreview(filePath: string): string {
  const root = publicExampleRoot(filePath);
  const sourceRoot = join(projectRoot, root);
  const publicRoot = join(projectRoot, 'public', root);

  mkdirSync(publicRoot, { recursive: true });
  cpSync(sourceRoot, publicRoot, {
    recursive: true,
    force: true,
    filter: (sourcePath) => shouldCopyPublicPreviewEntry(sourcePath, sourceRoot),
  });

  return withBase(`/${filePath}`);
}

// Publicado sempre: o link do cabecalho precisa de uma URL real, mesmo quando o
// quadro usa `srcdoc`.
const publicHref = publishPublicPreview(normalizedPath);
const publicPreviewSrc = serveFromPublic ? publicHref : undefined;

// Embute as imagens locais: em `srcdoc` o caminho relativo nao tem base.
const html = source.code.replace(
  /(\ssrc=")(?!https?:|data:|\/)([^"]+)(")/g,
  (match, before: string, target: string, after: string) => {
    const dataUri = readAssetDataUri(resolveRelative(path, target));
    return dataUri ? `${before}${dataUri}${after}` : match;
  }
);
---

<figure class="html-preview not-content my-4 overflow-hidden rounded-lg border border-sl-gray-5">
  <figcaption
    class="flex items-center gap-2 border-b border-sl-gray-5 bg-sl-gray-6 px-3.5 py-2 text-sl-xs text-sl-gray-2"
  >
    <span class="flex gap-1" aria-hidden="true">
      <span class="block size-2 rounded-full bg-sl-gray-4"></span>
      <span class="block size-2 rounded-full bg-sl-gray-4"></span>
      <span class="block size-2 rounded-full bg-sl-gray-4"></span>
    </span>
    <a
      class="inline-flex items-center gap-1 text-sl-gray-2 no-underline hover:text-sl-accent hover:underline"
      href={publicHref}
      target="_blank"
      rel="noopener"
      title="Abrir o arquivo em outra aba"
    >
      {label ?? source.fileName}
      <Icon name="external" size="0.85em" />
    </a>
  </figcaption>

  {
    publicPreviewSrc ? (
      <iframe
        class="block w-full border-0 bg-white"
        style={`height: ${height}`}
        title={`Renderização de ${label ?? source.fileName}`}
        sandbox=""
        loading="lazy"
        src={publicPreviewSrc}
      />
    ) : (
      <iframe
        class="block w-full border-0 bg-white"
        style={`height: ${height}`}
        title={`Renderização de ${label ?? source.fileName}`}
        sandbox=""
        loading="lazy"
        srcdoc={html}
      />
    )
  }
</figure>
