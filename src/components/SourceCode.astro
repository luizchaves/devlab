---
/**
 * `<SourceCode>` — bloco de codigo alimentado por um arquivo real do projeto.
 *
 * E uma fina camada sobre o `<Code>` do Expressive Code (reexportado pelo
 * Starlight): todas as props do Expressive Code continuam disponiveis
 * (`title`, `frame`, `mark`, `ins`, `del`, `diff` via `lang`, `wrap`,
 * `showLineNumbers`, `collapse`, `meta`, ...), e a unica prop adicional
 * obrigatoria e `path`.
 *
 * ```mdx
 * <SourceCode path="examples/express-mvc/src/app.js" />
 * <SourceCode path="examples/express-mvc/src/app.js" title="src/app.js" mark="5-8" showLineNumbers />
 * <SourceCode path="examples/express-mvc/src/app.js" region="middleware" />
 * <SourceCode path="examples/express-mvc/src/app.js" lines="5-18" />
 * ```
 *
 * `lang` e `title` sao inferidos a partir de `path` e podem ser sobrescritos.
 */
import { Code } from '@astrojs/starlight/components';
import type { SourceCodeProps } from '../lib/source-code';
import { normalizeMarkers } from '../lib/source-code';
import { loadSource } from '../lib/source-files';

type Props = SourceCodeProps;

const {
  path,
  region,
  lines,
  startLine,
  endLine,
  dedent,
  preserveLineNumbers = true,
  title,
  lang,
  startLineNumber,
  mark,
  ins,
  del: del_,
  ...expressiveCodeProps
} = Astro.props;

const source = loadSource({ path, region, lines, startLine, endLine, dedent });

if (!source.code.trim()) {
  throw new Error(
    `O trecho carregado de "${path}" esta vazio${region ? ` (regiao "${region}")` : ''}.`
  );
}

const resolvedStartLineNumber =
  startLineNumber ?? (preserveLineNumbers && source.isPartial ? source.firstLineNumber : undefined);
---

<Code
  {...expressiveCodeProps}
  code={source.code}
  lang={lang ?? source.lang}
  title={title ?? source.fileName}
  startLineNumber={resolvedStartLineNumber}
  mark={normalizeMarkers(mark)}
  ins={normalizeMarkers(ins)}
  del={normalizeMarkers(del_)}
/>
