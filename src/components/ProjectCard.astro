---
/**
 * `<ProjectCard>` — cartao de um projeto pratico.
 *
 * ```mdx
 * <ProjectCard {...getProject('express-mvc')} />
 * ```
 *
 * Pensado para viver dentro de `.project-grid` ou do `<CardGrid>` nativo do
 * Starlight, herdando as cores e o espacamento do tema.
 */
import { Icon } from '@astrojs/starlight/components';
import type { Project } from '../lib/projects';
import { repoUrl, withBase } from '../lib/site';

type Props = Project & {
  /** Oculta o link para o codigo-fonte. */
  hideSource?: boolean | undefined;
};

const LEVEL_CLASSES: Record<string, string> = {
  Iniciante: 'border-sl-green text-sl-green-high',
  Intermediário: 'border-sl-orange text-sl-orange-high',
  Avançado: 'border-sl-purple text-sl-purple-high',
};

const { name, description, level, tech, concepts, docs, source, hideSource = false } = Astro.props;

const docsHref = withBase(docs);
const sourceHref = repoUrl(source);
const levelClasses = LEVEL_CLASSES[level] ?? 'border-sl-gray-5 text-sl-gray-2';
---

<article
  class="not-content relative flex h-full flex-col gap-2 rounded-lg border border-sl-gray-5 bg-sl-black p-4 transition-colors hover:border-sl-gray-4 sm:p-5"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="m-0 text-sl-h5 leading-tight font-semibold text-sl-white">
      <!-- O ::after transforma o titulo no alvo clicavel do cartao inteiro. -->
      <a
        href={docsHref}
        class="text-inherit no-underline hover:text-sl-accent after:absolute after:inset-0 after:content-['']"
      >
        {name}
      </a>
    </h3>
    <span
      class:list={[
        'shrink-0 rounded-full border px-2 py-px text-sl-xs whitespace-nowrap',
        levelClasses,
      ]}
    >
      {level}
    </span>
  </div>

  <p class="m-0 text-sl-sm text-sl-gray-2">{description}</p>

  <p class="m-0 font-mono text-sl-xs text-sl-accent">{tech.join(' • ')}</p>

  {
    concepts.length > 0 && (
      <ul class="m-0 mt-1 flex list-none flex-wrap gap-1 p-0">
        {concepts.map((concept) => (
          <li class="rounded bg-sl-gray-6 px-1.5 py-px text-sl-xs text-sl-gray-2">{concept}</li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-3 text-sl-sm">
    <a href={docsHref} class="inline-flex items-center gap-1.5 text-sl-accent no-underline hover:underline">
      Ver projeto
      <Icon name="right-arrow" size="1em" class="rtl:flip" />
    </a>
    {
      !hideSource && (
        <a
          href={sourceHref}
          rel="noopener noreferrer"
          target="_blank"
          class="relative z-10 inline-flex items-center gap-1.5 text-sl-gray-2 no-underline hover:underline"
        >
          <Icon name="github" size="1em" />
          Código-fonte
        </a>
      )
    }
  </div>
</article>
