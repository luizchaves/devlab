---
/* Custom responsive SVG diagram for Python built-in data types taxonomy */
---

<div class="python-data-types-diagram-container">
  <svg viewBox="0 0 760 560" class="python-data-types-svg" xmlns="http://www.w3.org/2000/svg">
    <!-- Connectors: Root to Categories -->
    <path d="M 155 280 C 195 280, 195 84, 230 84" class="connector-line branch-core" />
    <path d="M 155 280 C 195 280, 195 224, 230 224" class="connector-line branch-sequence" />
    <path d="M 155 280 C 195 280, 195 348, 230 348" class="connector-line branch-mapping" />
    <path d="M 155 280 C 195 280, 195 460, 230 460" class="connector-line branch-special" />

    <!-- Connectors: Core scalar leaves -->
    <path d="M 410 84 C 435 84, 435 28, 460 28" class="connector-line branch-core" />
    <path d="M 410 84 C 435 84, 435 56, 460 56" class="connector-line branch-core" />
    <path d="M 410 84 C 435 84, 435 84, 460 84" class="connector-line branch-core" />
    <path d="M 410 84 C 435 84, 435 112, 460 112" class="connector-line branch-core" />
    <path d="M 410 84 C 435 84, 435 140, 460 140" class="connector-line branch-core" />

    <!-- Connectors: Sequence leaves -->
    <path d="M 410 224 C 435 224, 435 196, 460 196" class="connector-line branch-sequence" />
    <path d="M 410 224 C 435 224, 435 224, 460 224" class="connector-line branch-sequence" />
    <path d="M 410 224 C 435 224, 435 252, 460 252" class="connector-line branch-sequence" />
    <path d="M 410 224 C 435 224, 435 280, 460 280" class="connector-line branch-sequence" />

    <!-- Connectors: Mapping/set leaves -->
    <path d="M 410 348 C 435 348, 435 336, 460 336" class="connector-line branch-mapping" />
    <path d="M 410 348 C 435 348, 435 364, 460 364" class="connector-line branch-mapping" />
    <path d="M 410 348 C 435 348, 435 392, 460 392" class="connector-line branch-mapping" />

    <!-- Connectors: Special/object leaves -->
    <path d="M 410 460 C 435 460, 435 448, 460 448" class="connector-line branch-special" />
    <path d="M 410 460 C 435 460, 435 476, 460 476" class="connector-line branch-special" />
    <path d="M 410 460 C 435 460, 435 504, 460 504" class="connector-line branch-special" />

    <!-- Root node -->
    <g transform="translate(15, 255)">
      <rect x="0" y="0" width="140" height="50" rx="8" class="node-root" />
      <text x="70" y="25" class="text-root">Tipos Python</text>
    </g>

    <!-- Category nodes -->
    <g transform="translate(230, 61)">
      <rect x="0" y="0" width="180" height="46" rx="8" class="node-category node-core" />
      <text x="90" y="23" class="text-category">Escalares</text>
    </g>

    <g transform="translate(230, 201)">
      <rect x="0" y="0" width="180" height="46" rx="8" class="node-category node-sequence" />
      <text x="90" y="23" class="text-category">Sequências</text>
    </g>

    <g transform="translate(230, 325)">
      <rect x="0" y="0" width="180" height="46" rx="8" class="node-category node-mapping" />
      <text x="90" y="23" class="text-category">Mapas e Conjuntos</text>
    </g>

    <g transform="translate(230, 437)">
      <rect x="0" y="0" width="180" height="46" rx="8" class="node-category node-special" />
      <text x="90" y="23" class="text-category">Objetos Especiais</text>
    </g>

    <!-- Core scalar leaves -->
    <g transform="translate(460, 16)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">int</text>
      <text x="92" y="12" class="text-meta">inteiro arbitrário</text>
    </g>
    <g transform="translate(460, 44)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">float</text>
      <text x="92" y="12" class="text-meta">IEEE 754</text>
    </g>
    <g transform="translate(460, 72)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">complex</text>
      <text x="92" y="12" class="text-meta">3 + 4j</text>
    </g>
    <g transform="translate(460, 100)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">bool</text>
      <text x="92" y="12" class="text-meta">True / False</text>
    </g>
    <g transform="translate(460, 128)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">NoneType</text>
      <text x="92" y="12" class="text-meta">None</text>
    </g>

    <!-- Sequence leaves -->
    <g transform="translate(460, 184)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">str</text>
      <text x="92" y="12" class="text-meta">texto imutável</text>
    </g>
    <g transform="translate(460, 212)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">list</text>
      <text x="92" y="12" class="text-meta">mutável</text>
    </g>
    <g transform="translate(460, 240)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">tuple</text>
      <text x="92" y="12" class="text-meta">imutável</text>
    </g>
    <g transform="translate(460, 268)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">range</text>
      <text x="92" y="12" class="text-meta">sequência lazy</text>
    </g>

    <!-- Mapping/set leaves -->
    <g transform="translate(460, 324)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">dict</text>
      <text x="92" y="12" class="text-meta">chave-valor</text>
    </g>
    <g transform="translate(460, 352)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">set</text>
      <text x="92" y="12" class="text-meta">sem repetição</text>
    </g>
    <g transform="translate(460, 380)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">frozenset</text>
      <text x="92" y="12" class="text-meta">set imutável</text>
    </g>

    <!-- Special/object leaves -->
    <g transform="translate(460, 436)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">bytes</text>
      <text x="92" y="12" class="text-meta">bytes imutáveis</text>
    </g>
    <g transform="translate(460, 464)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">bytearray</text>
      <text x="92" y="12" class="text-meta">bytes mutáveis</text>
    </g>
    <g transform="translate(460, 492)">
      <rect x="0" y="0" width="205" height="24" rx="4" class="node-leaf" />
      <text x="12" y="12" class="text-leaf">object</text>
      <text x="92" y="12" class="text-meta">base comum</text>
    </g>
  </svg>
</div>

<style>
  .python-data-types-diagram-container {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    justify-content: center;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    box-sizing: border-box;
  }

  .python-data-types-svg {
    width: 100%;
    max-width: 760px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .connector-line {
    fill: none;
    stroke: var(--sl-color-gray-4, #64748b);
    stroke-width: 2;
    opacity: 0.68;
  }

  .branch-core {
    stroke: #38bdf8;
  }

  .branch-sequence {
    stroke: #34d399;
  }

  .branch-mapping {
    stroke: #f59e0b;
  }

  .branch-special {
    stroke: #c084fc;
  }

  .node-root {
    fill: #2563eb;
    stroke: #1d4ed8;
    stroke-width: 1.5;
  }

  .text-root {
    fill: #ffffff;
    font-size: 15px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .node-category {
    stroke-width: 2;
  }

  .node-core {
    fill: rgba(56, 189, 248, 0.12);
    stroke: #38bdf8;
  }

  .node-sequence {
    fill: rgba(52, 211, 153, 0.12);
    stroke: #34d399;
  }

  .node-mapping {
    fill: rgba(245, 158, 11, 0.12);
    stroke: #f59e0b;
  }

  .node-special {
    fill: rgba(192, 132, 252, 0.12);
    stroke: #c084fc;
  }

  .text-category {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 14px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .node-leaf {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.8));
    stroke: var(--sl-color-gray-4, #475569);
    stroke-width: 1.2;
  }

  .text-leaf {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 13px;
    font-weight: 700;
    font-family: var(--sl-font-mono, monospace);
    dominant-baseline: central;
  }

  .text-meta {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 11px;
    font-weight: 500;
    dominant-baseline: central;
  }
</style>
