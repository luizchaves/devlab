---
/* Recorte DER de agregação.
   Mermaid não possui uma notação própria para a caixa de agregação clássica, então
   este SVG mantém o desenho conceitual fiel sem transformar a agregação em tabela. */
---

<figure class="aggregation-diagram">
  <svg
    viewBox="0 0 690 380"
    class="aggregation-diagram__svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Recorte conceitual de agregação da matrícula em avaliações"
  >
    <rect x="68" y="34" width="554" height="198" class="aggregation-box" />
    <text x="345" y="61" class="text-label text-muted">Agregação: Matrícula</text>

    <rect x="96" y="124" width="124" height="54" rx="2" class="entity" />
    <text x="158" y="151" class="text-node">ALUNO</text>

    <path d="M 345 94 L 430 151 L 345 208 L 260 151 Z" class="relationship" />
    <text x="345" y="151" class="text-node">MATRICULA-SE</text>

    <rect x="470" y="124" width="124" height="54" rx="2" class="entity" />
    <text x="532" y="151" class="text-node">OFERTA</text>

    <path d="M 220 151 L 260 151" class="connector" />
    <path d="M 430 151 L 470 151" class="connector" />
    <text x="240" y="136" class="text-cardinality">N</text>
    <text x="450" y="136" class="text-cardinality">M</text>

    <path d="M 345 232 L 345 252" class="connector" />

    <path d="M 345 252 L 414 292 L 345 332 L 276 292 Z" class="relationship accent" />
    <text x="345" y="292" class="text-node">GERA</text>

    <path d="M 414 292 L 472 292" class="connector" />
    <text x="439" y="277" class="text-cardinality">1:N</text>

    <rect x="472" y="265" width="126" height="54" rx="2" class="entity accent" />
    <text x="535" y="292" class="text-node">AVALIACAO</text>
  </svg>
  <figcaption>Recorte conceitual de agregação da matrícula em avaliações.</figcaption>
</figure>

<style>
  .aggregation-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem 1rem;
    box-sizing: border-box;
  }

  .aggregation-diagram__svg {
    width: 100%;
    max-width: 690px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .aggregation-box {
    fill: rgba(56, 189, 248, 0.06);
    stroke: var(--sl-color-text-accent, #38bdf8);
    stroke-width: 1.8;
    stroke-dasharray: 8 6;
  }

  .entity {
    fill: var(--sl-color-bg, #0f172a);
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.6;
  }

  .relationship {
    fill: rgba(56, 189, 248, 0.12);
    stroke: var(--sl-color-text-accent, #38bdf8);
    stroke-width: 1.8;
  }

  .accent {
    fill: rgba(74, 222, 128, 0.12);
    stroke: #4ade80;
  }

  .connector {
    fill: none;
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.8;
  }

  .text-node,
  .text-label,
  .text-cardinality {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-node {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 14px;
    font-weight: 700;
  }

  .text-label {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 13px;
    font-weight: 700;
  }

  .text-muted {
    opacity: 0.95;
  }

  .text-cardinality {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 12px;
    font-weight: 700;
  }

  figcaption {
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
