---
/* Diagramas de Venn dos sete resultados possiveis de uma juncao entre A e B: a regiao
   preenchida e o que a consulta devolve. As variantes "sem a intersecao" recortam o outro
   circulo com uma mascara, em vez de pintar por cima, para funcionar em qualquer tema.
   Classes com prefixo venn- para nao colidir com utilitarios do Tailwind (.outline). */
interface Join {
  label: string;
  hint: string;
  where: string;
  x: number;
  y: number;
  fillA: boolean;
  fillB: boolean;
  fillBoth: boolean;
  clearBoth: boolean;
}

const joins: Join[] = [
  {
    label: 'INNER JOIN',
    hint: 'A ∩ B',
    where: '',
    x: 0,
    y: 0,
    fillA: false,
    fillB: false,
    fillBoth: true,
    clearBoth: false,
  },
  {
    label: 'LEFT JOIN',
    hint: 'A',
    where: '',
    x: 230,
    y: 0,
    fillA: true,
    fillB: false,
    fillBoth: true,
    clearBoth: false,
  },
  {
    label: 'RIGHT JOIN',
    hint: 'B',
    where: '',
    x: 460,
    y: 0,
    fillA: false,
    fillB: true,
    fillBoth: true,
    clearBoth: false,
  },
  {
    label: 'FULL OUTER JOIN',
    hint: 'A ∪ B',
    where: '',
    x: 0,
    y: 190,
    fillA: true,
    fillB: true,
    fillBoth: true,
    clearBoth: false,
  },
  {
    label: 'LEFT JOIN sem a interseção',
    hint: 'A − B',
    where: 'WHERE B.chave IS NULL',
    x: 230,
    y: 190,
    fillA: true,
    fillB: false,
    fillBoth: false,
    clearBoth: true,
  },
  {
    label: 'RIGHT JOIN sem a interseção',
    hint: 'B − A',
    where: 'WHERE A.chave IS NULL',
    x: 460,
    y: 190,
    fillA: false,
    fillB: true,
    fillBoth: false,
    clearBoth: true,
  },
  {
    label: 'FULL OUTER JOIN sem a interseção',
    hint: '(A ∪ B) − (A ∩ B)',
    where: 'WHERE A.chave IS NULL OR B.chave IS NULL',
    x: 230,
    y: 380,
    fillA: true,
    fillB: true,
    fillBoth: false,
    clearBoth: true,
  },
];

const A = { cx: 83, cy: 92, r: 50 };
const B = { cx: 147, cy: 92, r: 50 };
---

<figure class="join-venn-diagram">
  <svg
    viewBox="0 0 690 570"
    class="join-venn-diagram__svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Diagramas de Venn dos tipos de JOIN: INNER, LEFT, RIGHT, FULL OUTER e as três variantes sem a interseção"
  >
    <defs>
      <clipPath id="join-venn-clip-a">
        <circle cx={A.cx} cy={A.cy} r={A.r} />
      </clipPath>
      <mask id="join-venn-not-b">
        <rect x="0" y="0" width="230" height="190" fill="white" />
        <circle cx={B.cx} cy={B.cy} r={B.r} fill="black" />
      </mask>
      <mask id="join-venn-not-a">
        <rect x="0" y="0" width="230" height="190" fill="white" />
        <circle cx={A.cx} cy={A.cy} r={A.r} fill="black" />
      </mask>
    </defs>

    {
      joins.map((join) => (
        <g transform={`translate(${join.x} ${join.y})`}>
          <text x="115" y="22" class="text-title">
            {join.label}
          </text>

          {join.fillA && (
            <circle
              cx={A.cx}
              cy={A.cy}
              r={A.r}
              class="venn-fill"
              mask={join.clearBoth ? 'url(#join-venn-not-b)' : undefined}
            />
          )}
          {join.fillB && (
            <circle
              cx={B.cx}
              cy={B.cy}
              r={B.r}
              class="venn-fill"
              mask={join.clearBoth ? 'url(#join-venn-not-a)' : undefined}
            />
          )}
          {join.fillBoth && (
            <g clip-path="url(#join-venn-clip-a)">
              <circle cx={B.cx} cy={B.cy} r={B.r} class="venn-fill" />
            </g>
          )}

          <circle cx={A.cx} cy={A.cy} r={A.r} class="venn-outline" />
          <circle cx={B.cx} cy={B.cy} r={B.r} class="venn-outline" />

          <text x={A.cx - 24} y={A.cy} class="text-set">
            A
          </text>
          <text x={B.cx + 24} y={B.cy} class="text-set">
            B
          </text>
          <text x="115" y="158" class="text-hint">
            {join.hint}
          </text>
          {join.where && (
            <text x="115" y="174" class="text-where">
              {join.where}
            </text>
          )}
        </g>
      ))
    }
  </svg>
  <figcaption>
    Comportamento dos tipos de JOIN relacionais: a área preenchida é o que cada junção devolve, e as
    três variantes de baixo são obtidas com o filtro <code>IS NULL</code> indicado.
  </figcaption>
</figure>

<style>
  .join-venn-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem 1rem;
    box-sizing: border-box;
  }

  .join-venn-diagram__svg {
    width: 100%;
    max-width: 690px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .venn-fill {
    /* Cor solida (sem opacidade) para que a sobreposicao dos circulos fique uniforme. */
    fill: color-mix(in srgb, var(--sl-color-text-accent, #38bdf8) 45%, var(--sl-color-bg, #0f172a));
  }

  .venn-outline {
    fill: none;
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.8;
  }

  .text-title,
  .text-set,
  .text-hint,
  .text-where {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-title {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 12px;
    font-weight: 800;
  }

  .text-set {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 14px;
    font-weight: 800;
  }

  .text-hint {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 12px;
    font-weight: 700;
  }

  .text-where {
    fill: var(--sl-color-gray-3, #94a3b8);
    font-size: 10px;
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
  }

  figcaption {
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
