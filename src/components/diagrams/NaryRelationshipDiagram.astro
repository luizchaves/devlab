---
/* Recorte DER de relacionamento ternário/n-ário. */
---

<figure class="nary-relationship-diagram">
  <svg
    viewBox="0 0 680 360"
    class="nary-relationship-diagram__svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Recorte conceitual de relacionamento n-ário de oferta acadêmica"
  >
    <path d="M 340 118 L 430 180 L 340 242 L 250 180 Z" class="relationship" />
    <text x="340" y="180" class="text-node">OFERTA</text>

    <rect x="72" y="70" width="132" height="54" rx="2" class="entity" />
    <text x="138" y="97" class="text-node">PROFESSOR</text>

    <rect x="476" y="70" width="132" height="54" rx="2" class="entity" />
    <text x="542" y="97" class="text-node">DISCIPLINA</text>

    <rect x="72" y="236" width="132" height="54" rx="2" class="entity" />
    <text x="138" y="263" class="text-node">TURMA</text>

    <rect x="476" y="236" width="132" height="54" rx="2" class="entity" />
    <text x="542" y="263" class="text-node">SEMESTRE</text>

    <path d="M 204 97 L 250 180" class="connector" />
    <path d="M 476 97 L 430 180" class="connector" />
    <path d="M 204 263 L 250 180" class="connector" />
    <path d="M 476 263 L 430 180" class="connector" />

    <text x="240" y="106" class="text-cardinality">ministra</text>
    <text x="440" y="106" class="text-cardinality">compõe</text>
    <text x="236" y="255" class="text-cardinality">recebe</text>
    <text x="444" y="255" class="text-cardinality">organiza</text>

    <text x="340" y="320" class="text-note">
      OFERTA só existe quando professor, disciplina, turma e semestre participam juntos.
    </text>
  </svg>
  <figcaption>Recorte conceitual de relacionamento n-ário de oferta acadêmica.</figcaption>
</figure>

<style>
  .nary-relationship-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem 1rem;
    box-sizing: border-box;
  }

  .nary-relationship-diagram__svg {
    width: 100%;
    max-width: 680px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .entity {
    fill: var(--sl-color-bg, #0f172a);
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .relationship {
    fill: rgba(56, 189, 248, 0.12);
    stroke: var(--sl-color-text-accent, #38bdf8);
    stroke-width: 1.8;
  }

  .connector {
    fill: none;
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .text-node,
  .text-cardinality,
  .text-note {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-node {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 14px;
    font-weight: 800;
  }

  .text-cardinality,
  .text-note {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 12px;
    font-weight: 700;
  }

  figcaption {
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
