---
/* Um relacionamento binário na notação de Chen: duas entidades, um losango e as
   cardinalidades de cada lado. Mesmo estilo do DER conceitual do sistema acadêmico. */
interface Props {
  left: string;
  right: string;
  relationship: string;
  leftCardinality: string;
  rightCardinality: string;
  caption: string;
}

const { left, right, relationship, leftCardinality, rightCardinality, caption } = Astro.props;
const words = relationship.split(' ');
---

<figure class="cardinality-diagram">
  <svg
    viewBox="0 0 690 150"
    class="cardinality-diagram__svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={caption}
  >
    <rect x="58" y="48" width="132" height="54" rx="2" class="entity" />
    <text x="124" y="75" class="text-node">{left}</text>

    <path d="M 345 22 L 437 75 L 345 128 L 253 75 Z" class="relationship" />
    {
      words.length === 1 ? (
        <text x="345" y="75" class="text-node">
          {relationship}
        </text>
      ) : (
        <text x="345" y="69" class="text-node">
          <tspan x="345" dy="0">
            {words.slice(0, -1).join(' ')}
          </tspan>
          <tspan x="345" dy="16">
            {words.at(-1)}
          </tspan>
        </text>
      )
    }

    <rect x="500" y="48" width="132" height="54" rx="2" class="entity" />
    <text x="566" y="75" class="text-node">{right}</text>

    <path d="M 190 75 L 253 75" class="connector" />
    <path d="M 437 75 L 500 75" class="connector" />
    <text x="222" y="58" class="text-cardinality">{leftCardinality}</text>
    <text x="468" y="58" class="text-cardinality">{rightCardinality}</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .cardinality-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem 1rem;
    box-sizing: border-box;
  }

  .cardinality-diagram__svg {
    width: 100%;
    max-width: 690px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .entity {
    fill: var(--sl-color-bg, #0f172a);
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .relationship {
    fill: rgba(56, 189, 248, 0.12);
    stroke: var(--sl-color-text-accent, #38bdf8);
    stroke-width: 1.8;
  }

  .connector {
    fill: none;
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .text-node,
  .text-cardinality {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-node {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 14px;
    font-weight: 800;
  }

  .text-cardinality {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 12px;
    font-weight: 800;
  }

  figcaption {
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
