---
/* Custom responsive SVG tree for modern browser Web APIs */
---

<figure class="modern-web-apis-diagram" aria-labelledby="modern-web-apis-title">
  <svg viewBox="0 0 940 850" class="modern-web-apis-svg" xmlns="http://www.w3.org/2000/svg" role="img">
    <title id="modern-web-apis-title">Famílias de APIs Modernas do Navegador</title>
    <desc>
      Árvore em três níveis: navegador, famílias de APIs e especificações de APIs nativas.
    </desc>

    <!-- Level 1 to Level 2 Connectors -->
    <path d="M 164 425 C 202 425, 202 73, 240 73" class="connector-line branch-ui" />
    <path d="M 164 425 C 202 425, 202 218, 240 218" class="connector-line branch-dom" />
    <path d="M 164 425 C 202 425, 202 368, 240 368" class="connector-line branch-media" />
    <path d="M 164 425 C 202 425, 202 468, 240 468" class="connector-line branch-input" />
    <path d="M 164 425 C 202 425, 202 603, 240 603" class="connector-line branch-device" />
    <path d="M 164 425 C 202 425, 202 793, 240 793" class="connector-line branch-network" />

    <!-- Level 2 to Level 3 Connectors: Interface & Navegação -->
    <path d="M 430 73 C 458 73, 458 47, 486 47" class="connector-line branch-ui" />
    <path d="M 430 73 C 458 73, 458 87, 486 87" class="connector-line branch-ui" />
    <path d="M 430 73 C 458 73, 458 127, 486 127" class="connector-line branch-ui" />

    <!-- Level 2 to Level 3 Connectors: DOM API e Estrutura -->
    <path d="M 430 218 C 458 218, 458 177, 486 177" class="connector-line branch-dom" />
    <path d="M 430 218 C 458 218, 458 217, 486 217" class="connector-line branch-dom" />
    <path d="M 430 218 C 458 218, 458 257, 486 257" class="connector-line branch-dom" />
    <path d="M 430 218 C 458 218, 458 297, 486 297" class="connector-line branch-dom" />

    <!-- Level 2 to Level 3 Connectors: Desenho e Mídia -->
    <path d="M 430 368 C 458 368, 458 357, 486 357" class="connector-line branch-media" />
    <path d="M 430 368 C 458 368, 458 397, 486 397" class="connector-line branch-media" />

    <!-- Level 2 to Level 3 Connectors: Entrada e Transferência -->
    <path d="M 430 468 C 458 468, 458 457, 486 457" class="connector-line branch-input" />
    <path d="M 430 468 C 458 468, 458 497, 486 497" class="connector-line branch-input" />

    <!-- Level 2 to Level 3 Connectors: Dispositivo e Sistema -->
    <path d="M 430 603 C 458 603, 458 547, 486 547" class="connector-line branch-device" />
    <path d="M 430 603 C 458 603, 458 587, 486 587" class="connector-line branch-device" />
    <path d="M 430 603 C 458 603, 458 627, 486 627" class="connector-line branch-device" />
    <path d="M 430 603 C 458 603, 458 667, 486 667" class="connector-line branch-device" />
    <path d="M 430 603 C 458 603, 458 707, 486 707" class="connector-line branch-device" />

    <!-- Level 2 to Level 3 Connectors: Comunicação de Rede -->
    <path d="M 430 793 C 458 793, 458 777, 486 777" class="connector-line branch-network" />
    <path d="M 430 793 C 458 793, 458 817, 486 817" class="connector-line branch-network" />

    <!-- Level 1: Root Node -->
    <g transform="translate(14, 395)">
      <rect x="0" y="0" width="150" height="60" rx="8" class="node-root" />
      <text x="75" y="24" class="text-root">Navegador</text>
      <text x="75" y="42" class="text-root-sub">host do JS</text>
    </g>

    <!-- Level 2: Category Nodes -->
    <g transform="translate(240, 50)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-ui" />
      <text x="95" y="23" class="text-category">Interface & Navegação</text>
    </g>

    <g transform="translate(240, 195)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-dom" />
      <text x="95" y="23" class="text-category">DOM API e Estrutura</text>
    </g>

    <g transform="translate(240, 345)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-media" />
      <text x="95" y="23" class="text-category">Desenho e Mídia</text>
    </g>

    <g transform="translate(240, 445)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-input" />
      <text x="95" y="23" class="text-category">Entrada e Transferência</text>
    </g>

    <g transform="translate(240, 580)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-device" />
      <text x="95" y="23" class="text-category">Dispositivo e Sistema</text>
    </g>

    <g transform="translate(240, 770)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-network" />
      <text x="95" y="23" class="text-category">Comunicação de Rede</text>
    </g>

    <!-- Level 3: Leaf Nodes (Interactive API Links) -->
    <!-- Category 1: Interface & Navegação -->
    <a class="api-link" href="dialog/">
      <g transform="translate(486, 30)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Dialog API</text>
      </g>
    </a>

    <a class="api-link" href="../history/">
      <g transform="translate(486, 70)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">History API</text>
      </g>
    </a>

    <a class="api-link" href="fullscreen/">
      <g transform="translate(486, 110)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Fullscreen API</text>
      </g>
    </a>

    <!-- Category 2: DOM API e Estrutura -->
    <a class="api-link" href="../../dom/manipulation/">
      <g transform="translate(486, 160)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">DOM API (Manipulação)</text>
      </g>
    </a>

    <a class="api-link" href="../../dom/events/">
      <g transform="translate(486, 200)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">DOM Events API</text>
      </g>
    </a>

    <a class="api-link" href="../../dom/dynamic-elements/">
      <g transform="translate(486, 240)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">DOM Template API</text>
      </g>
    </a>

    <a class="api-link" href="../observers/">
      <g transform="translate(486, 280)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Observers API</text>
      </g>
    </a>

    <!-- Category 3: Desenho e Mídia -->
    <a class="api-link" href="canvas/">
      <g transform="translate(486, 340)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Canvas API</text>
      </g>
    </a>

    <a class="api-link" href="web-speech/">
      <g transform="translate(486, 380)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Web Speech API</text>
      </g>
    </a>

    <!-- Category 4: Entrada e Transferência -->
    <a class="api-link" href="drag-and-drop/">
      <g transform="translate(486, 440)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Drag and Drop API</text>
      </g>
    </a>

    <a class="api-link" href="clipboard/">
      <g transform="translate(486, 480)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Clipboard API</text>
      </g>
    </a>

    <!-- Category 5: Dispositivo e Sistema -->
    <a class="api-link" href="geolocation/">
      <g transform="translate(486, 530)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Geolocation API</text>
      </g>
    </a>

    <a class="api-link" href="notification/">
      <g transform="translate(486, 570)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Notification API</text>
      </g>
    </a>

    <a class="api-link" href="vibration/">
      <g transform="translate(486, 610)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Vibration API</text>
      </g>
    </a>

    <a class="api-link" href="web-storage/">
      <g transform="translate(486, 650)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Web Storage API</text>
      </g>
    </a>

    <a class="api-link" href="../workers/">
      <g transform="translate(486, 690)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Web Workers API</text>
      </g>
    </a>

    <!-- Category 6: Comunicação de Rede -->
    <a class="api-link" href="fetch/">
      <g transform="translate(486, 760)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Fetch API</text>
      </g>
    </a>

    <a class="api-link" href="../../http/websockets/">
      <g transform="translate(486, 800)">
        <rect x="0" y="0" width="210" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">WebSockets API</text>
      </g>
    </a>
  </svg>

  <figcaption>
    Árvore interativa em três níveis: o navegador expõe famílias de APIs nativas, agrupando especificações como a DOM API, DOM Events API, DOM Template API e Observers API.
  </figcaption>
</figure>

<style>
  .modern-web-apis-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    box-sizing: border-box;
  }

  .modern-web-apis-svg {
    width: 100%;
    max-width: 940px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .modern-web-apis-diagram figcaption {
    max-width: 52rem;
    margin: 0;
    color: var(--sl-color-gray-2, #cbd5e1);
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
  }

  .connector-line {
    fill: none;
    stroke: var(--sl-color-gray-4, #64748b);
    stroke-width: 2;
    opacity: 0.65;
  }

  .branch-ui {
    stroke: #38bdf8;
  }

  .branch-dom {
    stroke: #06b6d4;
  }

  .branch-media {
    stroke: #34d399;
  }

  .branch-input {
    stroke: #f59e0b;
  }

  .branch-device {
    stroke: #a78bfa;
  }

  .branch-network {
    stroke: #f472b6;
  }

  .node-root {
    fill: #2563eb;
    stroke: #1d4ed8;
    stroke-width: 1.5;
  }

  .node-category {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.82));
    stroke-width: 2;
  }

  .node-ui {
    stroke: #38bdf8;
  }

  .node-dom {
    stroke: #06b6d4;
  }

  .node-media {
    stroke: #34d399;
  }

  .node-input {
    stroke: #f59e0b;
  }

  .node-device {
    stroke: #a78bfa;
  }

  .node-network {
    stroke: #f472b6;
  }

  .node-leaf {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.8));
    stroke: var(--sl-color-gray-4, #475569);
    stroke-width: 1.2;
    transition: fill 120ms ease, stroke 120ms ease;
  }

  .api-link {
    cursor: pointer;
    text-decoration: none;
  }

  .api-link:hover .node-leaf,
  .api-link:focus .node-leaf {
    fill: var(--sl-color-accent-low, rgba(59, 130, 246, 0.2));
    stroke: var(--sl-color-text-accent, #38bdf8);
  }

  .text-root,
  .text-category {
    fill: var(--sl-color-text, #f8fafc);
    font-weight: 700;
    dominant-baseline: central;
  }

  .text-root {
    fill: #ffffff;
    font-size: 15px;
    text-anchor: middle;
  }

  .text-root-sub {
    fill: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-category {
    font-size: 14px;
    text-anchor: middle;
  }

  .text-leaf {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 13px;
    font-weight: 600;
    font-family: var(--sl-font-mono, monospace);
    dominant-baseline: central;
  }
</style>
