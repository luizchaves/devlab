---
/* Custom responsive SVG tree for browser Web APIs catalog */
---

<figure class="modern-web-apis-diagram" aria-labelledby="modern-web-apis-title">
  <svg viewBox="0 0 940 920" class="modern-web-apis-svg" xmlns="http://www.w3.org/2000/svg" role="img">
    <title id="modern-web-apis-title">Catálogo de Web APIs do Navegador</title>
    <desc>
      Árvore em três níveis: navegador, famílias de APIs e especificações de APIs nativas abordadas no guia.
    </desc>

    <!-- Level 1 to Level 2 Connectors -->
    <path d="M 164 460 C 202 460, 202 85, 240 85" class="connector-line branch-ui" />
    <path d="M 164 460 C 202 460, 202 245, 240 245" class="connector-line branch-dom" />
    <path d="M 164 460 C 202 460, 202 395, 240 395" class="connector-line branch-media" />
    <path d="M 164 460 C 202 460, 202 495, 240 495" class="connector-line branch-input" />
    <path d="M 164 460 C 202 460, 202 645, 240 645" class="connector-line branch-device" />
    <path d="M 164 460 C 202 460, 202 835, 240 835" class="connector-line branch-network" />

    <!-- Level 2 to Level 3 Connectors: Interface & Navegação -->
    <path d="M 430 85 C 458 85, 458 45, 486 45" class="connector-line branch-ui" />
    <path d="M 430 85 C 458 85, 458 85, 486 85" class="connector-line branch-ui" />
    <path d="M 430 85 C 458 85, 458 125, 486 125" class="connector-line branch-ui" />

    <!-- Level 2 to Level 3 Connectors: DOM API e Estrutura -->
    <path d="M 430 245 C 458 245, 458 175, 486 175" class="connector-line branch-dom" />
    <path d="M 430 245 C 458 245, 458 215, 486 215" class="connector-line branch-dom" />
    <path d="M 430 245 C 458 245, 458 255, 486 255" class="connector-line branch-dom" />
    <path d="M 430 245 C 458 245, 458 295, 486 295" class="connector-line branch-dom" />
    <path d="M 430 245 C 458 245, 458 335, 486 335" class="connector-line branch-dom" />

    <!-- Level 2 to Level 3 Connectors: Desenho e Mídia -->
    <path d="M 430 395 C 458 395, 458 385, 486 385" class="connector-line branch-media" />
    <path d="M 430 395 C 458 395, 458 425, 486 425" class="connector-line branch-media" />

    <!-- Level 2 to Level 3 Connectors: Entrada e Transferência -->
    <path d="M 430 495 C 458 495, 458 480, 486 480" class="connector-line branch-input" />
    <path d="M 430 495 C 458 495, 458 520, 486 520" class="connector-line branch-input" />

    <!-- Level 2 to Level 3 Connectors: Dispositivo e Sistema -->
    <path d="M 430 645 C 458 645, 458 575, 486 575" class="connector-line branch-device" />
    <path d="M 430 645 C 458 645, 458 610, 486 610" class="connector-line branch-device" />
    <path d="M 430 645 C 458 645, 458 645, 486 645" class="connector-line branch-device" />
    <path d="M 430 645 C 458 645, 458 680, 486 680" class="connector-line branch-device" />
    <path d="M 430 645 C 458 645, 458 715, 486 715" class="connector-line branch-device" />

    <!-- Level 2 to Level 3 Connectors: Comunicação de Rede -->
    <path d="M 430 835 C 458 835, 458 780, 486 780" class="connector-line branch-network" />
    <path d="M 430 835 C 458 835, 458 820, 486 820" class="connector-line branch-network" />
    <path d="M 430 835 C 458 835, 458 860, 486 860" class="connector-line branch-network" />
    <path d="M 430 835 C 458 835, 458 900, 486 900" class="connector-line branch-network" />

    <!-- Level 1: Root Node -->
    <g transform="translate(14, 430)">
      <rect x="0" y="0" width="150" height="60" rx="8" class="node-root" />
      <text x="75" y="24" class="text-root">Navegador</text>
      <text x="75" y="42" class="text-root-sub">host do JS</text>
    </g>

    <!-- Level 2: Category Nodes -->
    <g transform="translate(240, 62)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-ui" />
      <text x="95" y="23" class="text-category">Interface & Navegação</text>
    </g>

    <g transform="translate(240, 222)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-dom" />
      <text x="95" y="23" class="text-category">DOM API e Estrutura</text>
    </g>

    <g transform="translate(240, 372)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-media" />
      <text x="95" y="23" class="text-category">Desenho e Mídia</text>
    </g>

    <g transform="translate(240, 472)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-input" />
      <text x="95" y="23" class="text-category">Entrada e Transferência</text>
    </g>

    <g transform="translate(240, 622)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-device" />
      <text x="95" y="23" class="text-category">Dispositivo e Sistema</text>
    </g>

    <g transform="translate(240, 812)">
      <rect x="0" y="0" width="190" height="46" rx="8" class="node-category node-network" />
      <text x="95" y="23" class="text-category">Comunicação e Rede</text>
    </g>

    <!-- Level 3: Leaf Nodes (Interactive API Links) -->
    <!-- Category 1: Interface & Navegação -->
    <a class="api-link" href="../../ui/dialog/">
      <g transform="translate(486, 28)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Dialog API</text>
      </g>
    </a>

    <a class="api-link" href="../history/">
      <g transform="translate(486, 68)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">History API</text>
      </g>
    </a>

    <a class="api-link" href="../../ui/fullscreen/">
      <g transform="translate(486, 108)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Fullscreen API</text>
      </g>
    </a>

    <!-- Category 2: DOM API e Estrutura -->
    <a class="api-link" href="../../dom/manipulation/">
      <g transform="translate(486, 158)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">DOM API (Manipulação)</text>
      </g>
    </a>

    <a class="api-link" href="../../dom/events/">
      <g transform="translate(486, 198)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">DOM Events API</text>
      </g>
    </a>

    <a class="api-link" href="../../dom/forms/">
      <g transform="translate(486, 238)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Constraint Validation</text>
      </g>
    </a>

    <a class="api-link" href="../../dom/dynamic-elements/">
      <g transform="translate(486, 278)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">DOM Template API</text>
      </g>
    </a>

    <a class="api-link" href="../observers/">
      <g transform="translate(486, 318)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Observers API</text>
      </g>
    </a>

    <!-- Category 3: Desenho e Mídia -->
    <a class="api-link" href="../../media/canvas/">
      <g transform="translate(486, 368)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Canvas API (2D)</text>
      </g>
    </a>

    <a class="api-link" href="../../media/web-speech/">
      <g transform="translate(486, 408)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Web Speech API</text>
      </g>
    </a>

    <!-- Category 4: Entrada e Transferência -->
    <a class="api-link" href="../../input/drag-and-drop/">
      <g transform="translate(486, 463)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Drag and Drop API</text>
      </g>
    </a>

    <a class="api-link" href="../../input/clipboard/">
      <g transform="translate(486, 503)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Clipboard API</text>
      </g>
    </a>

    <!-- Category 5: Dispositivo e Sistema -->
    <a class="api-link" href="../../device/geolocation/">
      <g transform="translate(486, 558)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Geolocation API</text>
      </g>
    </a>

    <a class="api-link" href="../../device/notification/">
      <g transform="translate(486, 593)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Notification API</text>
      </g>
    </a>

    <a class="api-link" href="../../device/vibration/">
      <g transform="translate(486, 628)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Vibration API</text>
      </g>
    </a>

    <a class="api-link" href="../workers/">
      <g transform="translate(486, 663)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Web Workers API</text>
      </g>
    </a>

    <a class="api-link" href="../webassembly/">
      <g transform="translate(486, 698)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">WebAssembly (Wasm)</text>
      </g>
    </a>

    <!-- Category 6: Comunicação e Rede -->
    <a class="api-link" href="../../storage/local-storage/">
      <g transform="translate(486, 763)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Web Storage API</text>
      </g>
    </a>

    <a class="api-link" href="../../http/fetch/">
      <g transform="translate(486, 803)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Fetch API</text>
      </g>
    </a>

    <a class="api-link" href="../../http/sse/">
      <g transform="translate(486, 843)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">Server-Sent Events</text>
      </g>
    </a>

    <a class="api-link" href="../../http/websockets/">
      <g transform="translate(486, 883)">
        <rect x="0" y="0" width="220" height="34" rx="4" class="node-leaf" />
        <text x="14" y="17" class="text-leaf">WebSockets API</text>
      </g>
    </a>
  </svg>

  <figcaption>
    Árvore interativa em três níveis: o navegador expõe famílias de Web APIs nativas que compõem o currículo principal deste guia.
  </figcaption>
</figure>

<style>
  .modern-web-apis-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    box-sizing: border-box;
  }

  .modern-web-apis-svg {
    width: 100%;
    max-width: 940px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .modern-web-apis-diagram figcaption {
    max-width: 52rem;
    margin: 0;
    color: var(--sl-color-gray-2, #cbd5e1);
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
  }

  .connector-line {
    fill: none;
    stroke: var(--sl-color-gray-4, #64748b);
    stroke-width: 2;
    opacity: 0.65;
  }

  .branch-ui {
    stroke: #38bdf8;
  }

  .branch-dom {
    stroke: #06b6d4;
  }

  .branch-media {
    stroke: #34d399;
  }

  .branch-input {
    stroke: #f59e0b;
  }

  .branch-device {
    stroke: #a78bfa;
  }

  .branch-network {
    stroke: #f472b6;
  }

  .node-root {
    fill: #2563eb;
    stroke: #1d4ed8;
    stroke-width: 1.5;
  }

  .node-category {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.82));
    stroke-width: 2;
  }

  .node-ui {
    stroke: #38bdf8;
  }

  .node-dom {
    stroke: #06b6d4;
  }

  .node-media {
    stroke: #34d399;
  }

  .node-input {
    stroke: #f59e0b;
  }

  .node-device {
    stroke: #a78bfa;
  }

  .node-network {
    stroke: #f472b6;
  }

  .node-leaf {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.8));
    stroke: var(--sl-color-gray-4, #475569);
    stroke-width: 1.2;
    transition: fill 120ms ease, stroke 120ms ease;
  }

  .api-link {
    cursor: pointer;
    text-decoration: none;
  }

  .api-link:hover .node-leaf,
  .api-link:focus .node-leaf {
    fill: var(--sl-color-accent-low, rgba(59, 130, 246, 0.2));
    stroke: var(--sl-color-text-accent, #38bdf8);
  }

  .text-root,
  .text-category {
    fill: var(--sl-color-text, #f8fafc);
    font-weight: 700;
    dominant-baseline: central;
  }

  .text-root {
    fill: #ffffff;
    font-size: 15px;
    text-anchor: middle;
  }

  .text-root-sub {
    fill: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-category {
    font-size: 14px;
    text-anchor: middle;
  }

  .text-leaf {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 13px;
    font-weight: 600;
    font-family: var(--sl-font-mono, monospace);
    dominant-baseline: central;
  }
</style>
