---
/* Custom responsive SVG diagram for JavaScript Event Loop and Asynchronous Queues Architecture */
---

<figure class="event-loop-diagram" aria-labelledby="event-loop-title">
  <div class="event-loop-svg-container">
    <svg viewBox="0 0 920 612" class="event-loop-svg" xmlns="http://www.w3.org/2000/svg" role="img">
      <title id="event-loop-title">Arquitetura do Event Loop e Prioridade de Filas Assíncronas</title>
      <desc>
        Diagrama detalhando a Call Stack da thread principal, o processamento de I/O em Web APIs / Node C++ e a coordenação pelo Event Loop, que observa a pilha, retira os callbacks das duas filas (todas as microtarefas, depois uma única macrotarefa) e os empurra de volta para a Call Stack. No navegador, o mesmo laço ainda executa, no máximo uma vez por quadro, a etapa de renderização: callbacks de requestAnimationFrame, cálculo de estilo, layout, paint e composição.
      </desc>

      <defs>
        <!-- Arrow markers -->
        <marker id="arrow-blue" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#38bdf8" />
        </marker>
        <marker id="arrow-amber" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#fbbf24" />
        </marker>
        <marker id="arrow-emerald" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#34d399" />
        </marker>
        <marker id="arrow-orange" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#fb923c" />
        </marker>
        <marker id="arrow-purple" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#c084fc" />
        </marker>
      </defs>

      <!-- ================= TOP CONNECTIONS ================= -->

      <!-- 1. Call Stack -> Web APIs (Delegar I/O) -->
      <path d="M 275 62 C 460 2 460 2 645 62" class="connector connector-amber" marker-end="url(#arrow-amber)" />
      <g transform="translate(460, 26)">
        <rect x="-105" y="-12" width="210" height="24" rx="12" class="badge badge-amber" />
        <text x="0" y="4" class="badge-text">1. Dispara I/O assíncrono</text>
      </g>

      <!-- 3. Call Stack -> Event Loop (o loop observa a pilha) -->
      <path d="M 277 112 C 320 106 360 114 400 122" class="connector connector-purple" marker-end="url(#arrow-purple)" stroke-dasharray="5,4" />
      <g transform="translate(350, 94)">
        <rect x="-70" y="-11" width="140" height="22" rx="6" class="badge badge-purple" />
        <text x="0" y="4" class="badge-text">3. A pilha esvaziou?</text>
      </g>

      <!-- 6. Event Loop -> Call Stack (entrega o callback) -->
      <path d="M 402 154 C 360 162 330 166 281 170" class="connector connector-purple" marker-end="url(#arrow-purple)" />
      <g transform="translate(352, 190)">
        <rect x="-76" y="-11" width="152" height="22" rx="6" class="badge badge-purple" />
        <text x="0" y="4" class="badge-text">6. Empurra o callback</text>
      </g>

      <!-- ================= 1. CALL STACK (TOP LEFT) ================= -->
      <g transform="translate(25, 30)">
        <rect x="0" y="0" width="250" height="215" rx="10" class="group-box group-stack" />
        <rect x="0" y="0" width="250" height="36" rx="10" class="group-header group-header-stack" />
        <text x="125" y="23" class="group-title">CALL STACK (Thread Única)</text>

        <!-- Stack frames -->
        <g transform="translate(15, 48)">
          <rect x="0" y="0" width="220" height="32" rx="6" class="card card-stack-top" />
          <text x="110" y="20" class="card-text-center font-mono">funcaoAssincrona()</text>
          <text x="210" y="20" class="badge-mini-text font-mono">LIFO</text>
        </g>
        <g transform="translate(15, 86)">
          <rect x="0" y="0" width="220" height="32" rx="6" class="card card-stack" />
          <text x="110" y="20" class="card-text-center font-mono">processarDados()</text>
        </g>
        <g transform="translate(15, 124)">
          <rect x="0" y="0" width="220" height="32" rx="6" class="card card-stack" />
          <text x="110" y="20" class="card-text-center font-mono">script global (main)</text>
        </g>

        <!-- Stack status note -->
        <rect x="15" y="166" width="220" height="36" rx="6" class="card-sub-box" />
        <text x="125" y="181" class="card-sub-center">Executa código síncrono</text>
        <text x="125" y="195" class="card-sub-center-muted">Bloqueia o Loop enquanto ocupada</text>
      </g>

      <!-- ================= 2. EVENT LOOP (CENTER) ================= -->
      <g transform="translate(460, 137)">
        <!-- Rotating orbit visual -->
        <circle cx="0" cy="0" r="56" class="loop-orbit" />
        <circle cx="0" cy="0" r="44" class="loop-core" />
        <text x="0" y="-4" class="loop-title">EVENT LOOP</text>
        <text x="0" y="12" class="loop-subtitle">Orquestrador</text>
        <!-- Orbit tick dots -->
        <circle cx="0" cy="-56" r="3.5" class="loop-dot" />
        <circle cx="56" cy="0" r="3.5" class="loop-dot" />
        <circle cx="0" cy="56" r="3.5" class="loop-dot" />
        <circle cx="-56" cy="0" r="3.5" class="loop-dot" />
      </g>

      <!-- ================= 3. WEB APIS / BACKGROUND (TOP RIGHT) ================= -->
      <g transform="translate(645, 30)">
        <rect x="0" y="0" width="250" height="215" rx="10" class="group-box group-apis" />
        <rect x="0" y="0" width="250" height="36" rx="10" class="group-header group-header-apis" />
        <text x="125" y="23" class="group-title">APIs DO AMBIENTE</text>

        <!-- API items -->
        <g transform="translate(15, 48)">
          <rect x="0" y="0" width="220" height="26" rx="5" class="card card-api" />
          <text x="15" y="17" class="card-text font-mono">fetch() / Rede HTTP</text>
        </g>
        <g transform="translate(15, 80)">
          <rect x="0" y="0" width="220" height="26" rx="5" class="card card-api" />
          <text x="15" y="17" class="card-text font-mono">setTimeout() / Timers</text>
        </g>
        <g transform="translate(15, 112)">
          <rect x="0" y="0" width="220" height="26" rx="5" class="card card-api" />
          <text x="15" y="17" class="card-text font-mono">fs / I/O de Disco (Node)</text>
        </g>
        <g transform="translate(15, 144)">
          <rect x="0" y="0" width="220" height="26" rx="5" class="card card-api" />
          <text x="15" y="17" class="card-text font-mono">DOM Events / Cliques</text>
        </g>

        <!-- API status note -->
        <rect x="15" y="174" width="220" height="32" rx="6" class="card-sub-box" />
        <text x="125" y="187" class="card-sub-center">Multi-thread em background</text>
        <text x="125" y="199" class="card-sub-center-muted">Não bloqueia a Call Stack</text>
      </g>

      <!-- ================= BOTTOM CONNECTIONS ================= -->

      <!-- 2a. Web APIs -> Microtask Queue (Promise resolvida) -->
      <path d="M 685 245 C 685 285 365 255 365 304" class="connector connector-emerald" marker-end="url(#arrow-emerald)" />
      <g transform="translate(520, 275)">
        <rect x="-80" y="-11" width="160" height="22" rx="6" class="badge badge-emerald" />
        <text x="0" y="4" class="badge-text">2a. Promise resolve/reject</text>
      </g>

      <!-- 2b. Web APIs -> Macrotask Queue (Timer concluído) -->
      <path d="M 830 245 C 830 275 790 275 790 304" class="connector connector-orange" marker-end="url(#arrow-orange)" />
      <g transform="translate(805, 275)">
        <rect x="-70" y="-11" width="140" height="22" rx="6" class="badge badge-orange" />
        <text x="0" y="4" class="badge-text">2b. Timer / I/O pronto</text>
      </g>

      <!-- 4. Microtask Queue -> Event Loop (drena a fila inteira) -->
      <path d="M 432 310 C 432 262 438 228 447 196" class="connector connector-emerald" marker-end="url(#arrow-emerald)" />
      <g transform="translate(330, 262)">
        <rect x="-92" y="-11" width="184" height="22" rx="6" class="badge badge-emerald" />
        <text x="0" y="4" class="badge-text">4. Drena TODAS as microtasks</text>
      </g>

      <!-- 5. Macrotask Queue -> Event Loop (uma por ciclo) -->
      <path d="M 488 310 C 488 262 482 228 473 196" class="connector connector-orange" marker-end="url(#arrow-orange)" stroke-dasharray="5,4" />
      <g transform="translate(565, 232)">
        <rect x="-70" y="-11" width="140" height="22" rx="6" class="badge badge-orange" />
        <text x="0" y="4" class="badge-text">5. Depois, 1 macrotask</text>
      </g>

      <!-- ================= 4. MICROTASK QUEUE (BOTTOM LEFT) ================= -->
      <g transform="translate(25, 310)">
        <rect x="0" y="0" width="415" height="205" rx="10" class="group-box group-microtasks" />
        <rect x="0" y="0" width="415" height="36" rx="10" class="group-header group-header-microtasks" />
        <text x="207.5" y="23" class="group-title">MICROTASK QUEUE (Prioridade Máxima ⚡)</text>

        <!-- Banner -->
        <rect x="15" y="46" width="385" height="26" rx="5" class="card-banner-micro" />
        <text x="207.5" y="63" class="banner-text-micro font-mono">⚡ DRENADA 100% ATÉ O FIM A CADA CICLO DA STACK</text>

        <!-- Queue boxes -->
        <g transform="translate(15, 80)">
          <rect x="0" y="0" width="120" height="58" rx="6" class="card card-queue-micro" />
          <text x="60" y="24" class="card-queue-title">Promise Callbacks</text>
          <text x="60" y="42" class="card-queue-sub font-mono">.then / .catch</text>
        </g>
        <g transform="translate(147, 80)">
          <rect x="0" y="0" width="120" height="58" rx="6" class="card card-queue-micro" />
          <text x="60" y="24" class="card-queue-title">Async / Await</text>
          <text x="60" y="42" class="card-queue-sub font-mono">continuação</text>
        </g>
        <g transform="translate(280, 80)">
          <rect x="0" y="0" width="120" height="58" rx="6" class="card card-queue-micro" />
          <text x="60" y="24" class="card-queue-title">queueMicrotask</text>
          <text x="60" y="42" class="card-queue-sub font-mono">callbacks diretos</text>
        </g>

        <!-- Explanatory note -->
        <rect x="15" y="148" width="385" height="44" rx="6" class="card-sub-box" />
        <text x="207.5" y="165" class="card-sub-center">Precedência Absoluta:</text>
        <text x="207.5" y="180" class="card-sub-center-muted">Nenhuma macrotask roda enquanto houver microtasks pendentes</text>
      </g>

      <!-- ================= 5. MACROTASK QUEUE (BOTTOM RIGHT) ================= -->
      <g transform="translate(480, 310)">
        <rect x="0" y="0" width="415" height="205" rx="10" class="group-box group-macrotasks" />
        <rect x="0" y="0" width="415" height="36" rx="10" class="group-header group-header-macrotasks" />
        <text x="207.5" y="23" class="group-title">MACROTASK QUEUE (Task Queue ⏳)</text>

        <!-- Banner -->
        <rect x="15" y="46" width="385" height="26" rx="5" class="card-banner-macro" />
        <text x="207.5" y="63" class="banner-text-macro font-mono">⏳ PROCESSA APENAS 1 TAREFA POR CICLO DO LOOP</text>

        <!-- Queue boxes -->
        <g transform="translate(15, 80)">
          <rect x="0" y="0" width="120" height="58" rx="6" class="card card-queue-macro" />
          <text x="60" y="24" class="card-queue-title">Timers</text>
          <text x="60" y="42" class="card-queue-sub font-mono">setTimeout / Int.</text>
        </g>
        <g transform="translate(147, 80)">
          <rect x="0" y="0" width="120" height="58" rx="6" class="card card-queue-macro" />
          <text x="60" y="24" class="card-queue-title">I/O &amp; Rede</text>
          <text x="60" y="42" class="card-queue-sub font-mono">leitura / rede</text>
        </g>
        <g transform="translate(280, 80)">
          <rect x="0" y="0" width="120" height="58" rx="6" class="card card-queue-macro" />
          <text x="60" y="24" class="card-queue-title">Node.js / Eventos</text>
          <text x="60" y="42" class="card-queue-sub font-mono">setImmediate / UI</text>
        </g>

        <!-- Explanatory note -->
        <rect x="15" y="148" width="385" height="44" rx="6" class="card-sub-box" />
        <text x="207.5" y="165" class="card-sub-center">Cadência Controlada:</text>
        <text x="207.5" y="180" class="card-sub-center-muted">Após executar 1 macrotask, o loop retorna e confere microtasks novamente</text>
      </g>

      <!-- 7. Event Loop -> Renderização (corredor central, entre as duas filas) -->
      <path d="M 460 196 L 460 522" class="connector connector-purple" marker-end="url(#arrow-purple)" stroke-dasharray="3,5" />

      <!-- ================= 6. RENDERIZAÇÃO (FAIXA INFERIOR) ================= -->
      <g transform="translate(25, 528)">
        <rect x="0" y="0" width="870" height="74" rx="10" class="group-box group-render" />
        <rect x="0" y="0" width="870" height="30" rx="10" class="group-header group-header-render" />
        <text x="435" y="20" class="group-title">7. RENDERIZAÇÃO · no máximo uma vez por quadro (~16 ms) · apenas no navegador</text>

        <g transform="translate(14, 38)">
          <rect x="0" y="0" width="160" height="26" rx="5" class="card card-render" />
          <text x="80" y="17" class="card-render-text font-mono">requestAnimationFrame</text>
        </g>
        <path d="M 178 51 L 194 51" class="connector connector-purple" marker-end="url(#arrow-purple)" />

        <g transform="translate(198, 38)">
          <rect x="0" y="0" width="160" height="26" rx="5" class="card card-render" />
          <text x="80" y="17" class="card-render-text">Estilo (style)</text>
        </g>
        <path d="M 362 51 L 378 51" class="connector connector-purple" marker-end="url(#arrow-purple)" />

        <g transform="translate(382, 38)">
          <rect x="0" y="0" width="160" height="26" rx="5" class="card card-render" />
          <text x="80" y="17" class="card-render-text">Layout (reflow)</text>
        </g>
        <path d="M 546 51 L 562 51" class="connector connector-purple" marker-end="url(#arrow-purple)" />

        <g transform="translate(566, 38)">
          <rect x="0" y="0" width="140" height="26" rx="5" class="card card-render" />
          <text x="70" y="17" class="card-render-text">Paint</text>
        </g>
        <path d="M 710 51 L 726 51" class="connector connector-purple" marker-end="url(#arrow-purple)" />

        <g transform="translate(730, 38)">
          <rect x="0" y="0" width="126" height="26" rx="5" class="card card-render" />
          <text x="63" y="17" class="card-render-text">Composite</text>
        </g>
      </g>
    </svg>
  </div>
  <figcaption class="event-loop-caption">
    Fluxo de prioridades do motor JavaScript: enquanto o código síncrono executa na Call Stack, tarefas de I/O são processadas em segundo plano pelas APIs do ambiente. Todo callback pronto passa pelo <strong>Event Loop</strong>, que só age quando a pilha esvazia: ele drena <strong>todas as microtarefas</strong> (Promises), retira <strong>uma única macrotarefa</strong> (como <code>setTimeout</code>) e empurra cada uma para a Call Stack antes de recomeçar o ciclo. No navegador, é também o Event Loop que dispara a etapa de renderização, no máximo uma vez por quadro.
  </figcaption>
</figure>

<style>
  .event-loop-diagram {
    width: 100%;
    margin: 2rem 0;
  }

  .event-loop-svg-container {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.4));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    box-sizing: border-box;
  }

  .event-loop-svg {
    width: 100%;
    max-width: 920px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .font-mono {
    font-family: var(--sl-font-mono, monospace);
  }

  /* Group Boxes */
  .group-box {
    fill: var(--sl-color-bg, #090d16);
    stroke-width: 1.5;
  }
  .group-stack { stroke: #3b82f6; }
  .group-apis { stroke: #f59e0b; }
  .group-microtasks { stroke: #10b981; }
  .group-macrotasks { stroke: #f97316; }
  .group-render { stroke: #a855f7; }

  /* Group Headers */
  .group-header-stack { fill: #1d4ed8; }
  .group-header-apis { fill: #b45309; }
  .group-header-microtasks { fill: #047857; }
  .group-header-macrotasks { fill: #c2410c; }
  .group-header-render { fill: #6d28d9; }

  .group-title {
    fill: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.04em;
  }

  /* Cards inside Groups */
  .card {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.8));
    stroke-width: 1.2;
  }
  .card-stack { stroke: rgba(59, 130, 246, 0.5); fill: rgba(59, 130, 246, 0.12); }
  .card-stack-top { stroke: #38bdf8; fill: rgba(56, 189, 248, 0.18); }
  .card-api { stroke: rgba(245, 158, 11, 0.45); fill: rgba(245, 158, 11, 0.12); }
  .card-queue-micro { stroke: rgba(16, 185, 129, 0.5); fill: rgba(16, 185, 129, 0.12); }
  .card-queue-macro { stroke: rgba(249, 115, 22, 0.5); fill: rgba(249, 115, 22, 0.12); }
  .card-render { stroke: rgba(168, 85, 247, 0.5); fill: rgba(168, 85, 247, 0.12); }

  .card-render-text {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 11px;
    font-weight: 600;
    text-anchor: middle;
  }

  .card-text {
    fill: var(--sl-color-text, #f1f5f9);
    font-size: 11px;
    font-weight: 600;
  }
  .card-text-center {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 12px;
    font-weight: 700;
    text-anchor: middle;
  }
  .badge-mini-text {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 9px;
    font-weight: 800;
    text-anchor: end;
  }

  .card-queue-title {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .card-queue-sub {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 10px;
    font-weight: 600;
    text-anchor: middle;
  }

  /* Banners */
  .card-banner-micro { fill: rgba(16, 185, 129, 0.16); stroke: #10b981; stroke-width: 1; }
  .banner-text-micro { fill: #34d399; font-size: 10px; font-weight: 800; text-anchor: middle; }
  .card-banner-macro { fill: rgba(249, 115, 22, 0.16); stroke: #f97316; stroke-width: 1; }
  .banner-text-macro { fill: #fb923c; font-size: 10px; font-weight: 800; text-anchor: middle; }

  /* Sub boxes */
  .card-sub-box {
    fill: var(--sl-color-bg, rgba(30, 41, 59, 0.7));
    stroke: var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    stroke-width: 1;
  }
  .card-sub-center {
    fill: var(--sl-color-text, #f1f5f9);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .card-sub-center-muted {
    fill: var(--sl-color-text, #94a3b8);
    opacity: 0.75;
    font-size: 10px;
    font-weight: 500;
    text-anchor: middle;
  }

  /* Event Loop Center */
  .loop-orbit {
    fill: rgba(168, 85, 247, 0.08);
    stroke: #c084fc;
    stroke-width: 2;
    stroke-dasharray: 6, 4;
  }
  .loop-core {
    fill: #7c3aed;
    stroke: #a855f7;
    stroke-width: 2;
  }
  .loop-title {
    fill: #ffffff;
    font-size: 11px;
    font-weight: 800;
    text-anchor: middle;
    letter-spacing: 0.05em;
  }
  .loop-subtitle {
    fill: #e9d5ff;
    font-size: 9px;
    font-weight: 600;
    text-anchor: middle;
  }
  .loop-dot {
    fill: #c084fc;
  }

  /* Connectors */
  .connector {
    fill: none;
    stroke-width: 2;
  }
  .connector-amber { stroke: #fbbf24; }
  .connector-purple { stroke: #c084fc; }
  .connector-emerald { stroke: #34d399; }
  .connector-orange { stroke: #fb923c; }

  /* Badges */
  .badge {
    stroke-width: 1;
  }
  .badge-amber { fill: #78350f; stroke: #fbbf24; }
  .badge-purple { fill: #581c87; stroke: #c084fc; }
  .badge-emerald { fill: #064e3b; stroke: #34d399; }
  .badge-orange { fill: #7c2d12; stroke: #fb923c; }

  .badge-text {
    fill: #ffffff;
    font-size: 10px;
    font-weight: 700;
    text-anchor: middle;
  }

  .event-loop-caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--sl-color-gray-3, #94a3b8);
    text-align: center;
  }

  .event-loop-caption strong {
    color: var(--sl-color-text, #f8fafc);
  }

  /* Specific high-contrast adjustments for light mode */
  :global([data-theme='light']) .banner-text-micro {
    fill: #047857;
  }
  :global([data-theme='light']) .banner-text-macro {
    fill: #c2410c;
  }
  :global([data-theme='light']) .card-queue-sub {
    fill: #0284c7;
  }
  :global([data-theme='light']) .card-sub-box {
    fill: #f8fafc;
    stroke: rgba(0, 0, 0, 0.12);
  }
  :global([data-theme='light']) .card-stack {
    fill: rgba(59, 130, 246, 0.08);
  }
  :global([data-theme='light']) .card-stack-top {
    fill: rgba(56, 189, 248, 0.12);
  }
  :global([data-theme='light']) .card-api {
    fill: rgba(245, 158, 11, 0.08);
