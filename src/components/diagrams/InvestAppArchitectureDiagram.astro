---
/* Custom responsive SVG diagram for InvestApp Full-Stack Architecture */
---

<div class="investapp-arch-diagram-container">
  <svg viewBox="0 0 840 500" class="investapp-arch-svg" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Markers for arrows -->
      <marker id="arrow-blue" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#38bdf8" />
      </marker>
      <marker id="arrow-emerald" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#34d399" />
      </marker>
      <marker id="arrow-purple" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#c084fc" />
      </marker>
    </defs>

    <!-- COLUMN 1: CLIENT -->
    <g transform="translate(20, 20)">
      <rect x="0" y="0" width="240" height="460" rx="12" class="group-box group-client" />
      <rect x="0" y="0" width="240" height="38" rx="12" class="group-header group-header-client" />
      <text x="120" y="24" class="group-title">1. CLIENT (Navegador)</text>

      <!-- Client Card 1 -->
      <g transform="translate(15, 55)">
        <rect x="0" y="0" width="210" height="70" rx="8" class="card card-client" />
        <text x="15" y="24" class="card-title">Páginas HTML + CSS</text>
        <text x="15" y="46" class="card-sub">home.html, profile.html, signin.html</text>
      </g>

      <!-- Connection 1 -->
      <path d="M 120 125 L 120 150" class="connector connector-client" marker-end="url(#arrow-blue)" />

      <!-- Client Card 2 -->
      <g transform="translate(15, 150)">
        <rect x="0" y="0" width="210" height="80" rx="8" class="card card-client" />
        <text x="15" y="24" class="card-title">JavaScript Client</text>
        <text x="15" y="44" class="card-sub">services/api.js (fetch + Bearer Auth)</text>
        <text x="15" y="62" class="card-sub">Tratamento de 401 & Redirecionamento</text>
      </g>

      <!-- Connection 2 -->
      <path d="M 120 230 L 120 255" class="connector connector-client" marker-end="url(#arrow-blue)" />

      <!-- Client Card 3 -->
      <g transform="translate(15, 255)">
        <rect x="0" y="0" width="210" height="65" rx="8" class="card card-client" />
        <text x="15" y="24" class="card-title">Armazenamento Local</text>
        <text x="15" y="46" class="card-sub">localStorage (Token JWT)</text>
      </g>
    </g>

    <!-- HTTP REST CONNECTION BETWEEN CLIENT AND SERVER -->
    <path d="M 260 190 L 295 190" class="connector connector-http" marker-end="url(#arrow-purple)" stroke-dasharray="4,4" />
    <rect x="252" y="165" width="45" height="20" rx="4" class="badge-http" />
    <text x="274.5" y="179" class="badge-http-text">REST</text>

    <!-- COLUMN 2: SERVER -->
    <g transform="translate(300, 20)">
      <rect x="0" y="0" width="250" height="460" rx="12" class="group-box group-server" />
      <rect x="0" y="0" width="250" height="38" rx="12" class="group-header group-header-server" />
      <text x="125" y="24" class="group-title">2. SERVIDOR (Express + TS)</text>

      <!-- Server Card 1: Entrypoint -->
      <g transform="translate(15, 55)">
        <rect x="0" y="0" width="220" height="60" rx="8" class="card card-server" />
        <text x="15" y="24" class="card-title">Entrypoint (src/index.ts)</text>
        <text x="15" y="44" class="card-sub">Express App + express.static('public')</text>
      </g>

      <!-- Connection -->
      <path d="M 125 115 L 125 135" class="connector connector-server" marker-end="url(#arrow-purple)" />

      <!-- Server Card 2: Middlewares -->
      <g transform="translate(15, 135)">
        <rect x="0" y="0" width="220" height="85" rx="8" class="card card-server" />
        <text x="15" y="22" class="card-title">Camada de Middlewares</text>
        <text x="15" y="42" class="card-sub">• isAuthenticated (Validação JWT)</text>
        <text x="15" y="58" class="card-sub">• validate(schema) (Schemas Zod)</text>
        <text x="15" y="74" class="card-sub">• errorHandler (Tratamento HttpError)</text>
      </g>

      <!-- Connection -->
      <path d="M 125 220 L 125 240" class="connector connector-server" marker-end="url(#arrow-purple)" />

      <!-- Server Card 3: Controllers -->
      <g transform="translate(15, 240)">
        <rect x="0" y="0" width="220" height="80" rx="8" class="card card-server" />
        <text x="15" y="22" class="card-title">Controllers (MVC)</text>
        <text x="15" y="42" class="card-sub">auth.controller.ts, users.controller.ts</text>
        <text x="15" y="60" class="card-sub">investments.controller.ts</text>
      </g>

      <!-- Connection -->
      <path d="M 125 320 L 125 340" class="connector connector-server" marker-end="url(#arrow-purple)" />

      <!-- Server Card 4: Services -->
      <g transform="translate(15, 340)">
        <rect x="0" y="0" width="220" height="75" rx="8" class="card card-server" />
        <text x="15" y="22" class="card-title">Serviços Especiais</text>
        <text x="15" y="42" class="card-sub">SendMail.ts (E-mail SMTP)</text>
        <text x="15" y="60" class="card-sub">multer.ts (Upload Multipart)</text>
      </g>
    </g>

    <!-- CONNECTIONS FROM SERVER TO INFRASTRUCTURE -->
    <!-- Controllers -> Prisma -->
    <path d="M 550 280 L 570 280 L 570 92 L 585 92" class="connector connector-infra" marker-end="url(#arrow-emerald)" />
    <!-- Services -> Uploads -->
    <path d="M 550 375 L 585 375" class="connector connector-infra" marker-end="url(#arrow-emerald)" />

    <!-- COLUMN 3: INFRASTRUCTURE -->
    <g transform="translate(580, 20)">
      <rect x="0" y="0" width="240" height="460" rx="12" class="group-box group-infra" />
      <rect x="0" y="0" width="240" height="38" rx="12" class="group-header group-header-infra" />
      <text x="120" y="24" class="group-title">3. PERSISTÊNCIA & INFRA</text>

      <!-- Infra Card 1: Prisma -->
      <g transform="translate(15, 55)">
        <rect x="0" y="0" width="210" height="75" rx="8" class="card card-infra" />
        <text x="15" y="24" class="card-title">Prisma ORM</text>
        <text x="15" y="44" class="card-sub">schema.prisma & PrismaClient</text>
        <text x="15" y="60" class="card-sub">Migrations versionadas</text>
      </g>

      <!-- Connection Prisma -> DB -->
      <path d="M 120 130 L 120 155" class="connector connector-infra" marker-end="url(#arrow-emerald)" />

      <!-- Infra Card 2: SQLite DB -->
      <g transform="translate(15, 155)">
        <rect x="0" y="0" width="210" height="85" rx="8" class="card card-infra" />
        <text x="15" y="22" class="card-title">Banco SQLite (dev.db)</text>
        <text x="15" y="42" class="card-sub">Tabelas: User, Investment,</text>
        <text x="15" y="58" class="card-sub">Category, Broker, Image</text>
        <text x="15" y="74" class="card-sub">Integridade Referencial FK</text>
      </g>

      <!-- Infra Card 3: Disk Storage -->
      <g transform="translate(15, 260)">
        <rect x="0" y="0" width="210" height="75" rx="8" class="card card-infra" />
        <text x="15" y="24" class="card-title">Diretório de Uploads</text>
        <text x="15" y="44" class="card-sub">/public/imgs/profile/</text>
        <text x="15" y="60" class="card-sub">Volume persistente Docker</text>
      </g>

      <!-- Infra Card 4: SMTP -->
      <g transform="translate(15, 355)">
        <rect x="0" y="0" width="210" height="75" rx="8" class="card card-infra" />
        <text x="15" y="24" class="card-title">Servidor SMTP</text>
        <text x="15" y="44" class="card-sub">Nodemailer / E-mail Transacional</text>
        <text x="15" y="60" class="card-sub">Confirmação de cadastro</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .investapp-arch-diagram-container {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    justify-content: center;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.4));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 0.75rem;
    box-sizing: border-box;
  }

  .investapp-arch-svg {
    width: 100%;
    max-width: 840px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  /* Group Containers */
  .group-box {
    stroke-width: 1.5;
    fill-opacity: 0.15;
  }
  .group-client {
    fill: #0284c7;
    stroke: #38bdf8;
  }
  .group-server {
    fill: #7c3aed;
    stroke: #c084fc;
  }
  .group-infra {
    fill: #059669;
    stroke: #34d399;
  }

  /* Group Headers */
  .group-header-client { fill: #0284c7; }
  .group-header-server { fill: #7c3aed; }
  .group-header-infra { fill: #059669; }

  .group-title {
    fill: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.03em;
  }

  /* Cards inside Groups */
  .card {
    fill: var(--sl-color-bg, #0f172a);
    stroke-width: 1.2;
  }
  .card-client { stroke: rgba(56, 189, 248, 0.4); }
  .card-server { stroke: rgba(192, 132, 252, 0.4); }
  .card-infra { stroke: rgba(52, 211, 153, 0.4); }

  .card-title {
    fill: var(--sl-color-white, #f8fafc);
    font-size: 13px;
    font-weight: 700;
  }

  .card-sub {
    fill: var(--sl-color-gray-3, #94a3b8);
    font-size: 11px;
    font-weight: 500;
  }

  /* Connectors */
  .connector {
    fill: none;
    stroke-width: 2;
  }
  .connector-client { stroke: #38bdf8; }
  .connector-server { stroke: #c084fc; }
  .connector-infra { stroke: #34d399; }
  .connector-http { stroke: #c084fc; }

  .badge-http {
    fill: #7c3aed;
  }
  .badge-http-text {
    fill: #ffffff;
    font-size: 10px;
    font-weight: 700;
    text-anchor: middle;
  }
</style>
