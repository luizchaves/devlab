---
/* DER conceitual do sistema acadêmico, sem atributos e sem tabelas físicas. */
---

<figure class="academic-conceptual-er-diagram">
  <svg
    viewBox="0 0 690 420"
    class="academic-conceptual-er-diagram__svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Diagrama Entidade-Relacionamento conceitual do sistema acadêmico"
  >
    <rect x="58" y="48" width="132" height="54" rx="2" class="entity" />
    <text x="124" y="75" class="text-node">PROFESSOR</text>

    <path d="M 345 24 L 425 75 L 345 126 L 265 75 Z" class="relationship" />
    <text x="345" y="75" class="text-node">POSSUI</text>

    <rect x="500" y="48" width="132" height="54" rx="2" class="entity" />
    <text x="566" y="75" class="text-node">PERFIL</text>

    <path d="M 190 75 L 265 75" class="connector" />
    <path d="M 425 75 L 500 75" class="connector" />
    <text x="226" y="58" class="text-cardinality">1</text>
    <text x="462" y="58" class="text-cardinality">0..1</text>

    <rect x="58" y="304" width="132" height="54" rx="2" class="entity" />
    <text x="124" y="331" class="text-node">TURMA</text>

    <path d="M 345 280 L 437 331 L 345 382 L 253 331 Z" class="relationship" />
    <text x="345" y="325" class="text-node">
      <tspan x="345" dy="0">MATRICULADO</tspan>
      <tspan x="345" dy="16">EM</tspan>
    </text>

    <rect x="500" y="304" width="132" height="54" rx="2" class="entity" />
    <text x="566" y="331" class="text-node">ALUNO</text>

    <path d="M 190 331 L 253 331" class="connector" />
    <path d="M 437 331 L 500 331" class="connector" />
    <text x="222" y="314" class="text-cardinality">N</text>
    <text x="468" y="314" class="text-cardinality">M</text>

    <path d="M 124 150 L 202 201 L 124 252 L 46 201 Z" class="relationship" />
    <text x="124" y="201" class="text-node">MINISTRA</text>

    <path d="M 124 102 L 124 150" class="connector" />
    <path d="M 124 252 L 124 304" class="connector" />
    <text x="104" y="128" class="text-cardinality">1</text>
    <text x="104" y="278" class="text-cardinality">N</text>
  </svg>
  <figcaption>Diagrama Entidade-Relacionamento (DER) conceitual do sistema acadêmico.</figcaption>
</figure>

<style>
  .academic-conceptual-er-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem 1rem;
    box-sizing: border-box;
  }

  .academic-conceptual-er-diagram__svg {
    width: 100%;
    max-width: 690px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .entity {
    fill: var(--sl-color-bg, #0f172a);
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .relationship {
    fill: rgba(56, 189, 248, 0.12);
    stroke: var(--sl-color-text-accent, #38bdf8);
    stroke-width: 1.8;
  }

  .connector {
    fill: none;
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .text-node,
  .text-cardinality {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-node {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 14px;
    font-weight: 800;
  }

  .text-cardinality {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 12px;
    font-weight: 800;
  }

  figcaption {
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
