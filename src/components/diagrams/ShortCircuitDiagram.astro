---
/* SVG responsivo: avaliação em curto-circuito de &&, || e ?? lado a lado.
   Escrito em SVG (e não em Mermaid) porque três fluxos independentes empilhados
   verticalmente pelo Mermaid produzem um diagrama estreito e muito alto. */

const panels = [
  {
    x: 0,
    operator: 'A && B',
    question: ['A é falsy?'],
    left: { label: 'Sim', result: 'Retorna A' },
    right: { label: 'Não', result: 'Avalia B' },
    note: 'qualquer falsy interrompe',
  },
  {
    x: 240,
    operator: 'A || B',
    question: ['A é truthy?'],
    left: { label: 'Sim', result: 'Retorna A' },
    right: { label: 'Não', result: 'Avalia B' },
    note: 'qualquer truthy interrompe',
  },
  {
    x: 480,
    operator: 'A ?? B',
    question: ['A é null', 'ou undefined?'],
    left: { label: 'Não', result: 'Retorna A' },
    right: { label: 'Sim', result: 'Avalia B' },
    note: '0 e "" seguem como A',
  },
];
---

<div class="short-circuit-container">
  <svg viewBox="0 0 690 250" class="short-circuit-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Avaliação em curto-circuito dos operadores lógico E, lógico OU e coalescência nula">
    {panels.map((panel) => (
      <g transform={`translate(${panel.x}, 0)`}>
        <rect x="0" y="8" width="210" height="234" rx="12" class="panel" />
        <text x="105" y="34" class="text-operator">{panel.operator}</text>

        <rect x="10" y="50" width="190" height="44" rx="8" class="node-question" />
        {panel.question.length === 1 ? (
          <text x="105" y="72" class="text-question">{panel.question[0]}</text>
        ) : (
          <text x="105" y="64" class="text-question">
            <tspan x="105" dy="0">{panel.question[0]}</tspan>
            <tspan x="105" dy="16">{panel.question[1]}</tspan>
          </text>
        )}

        <path d="M 70 94 C 55 112, 55 118, 55 142" class="connector connector-left" marker-end="url(#sc-arrow)" />
        <path d="M 140 94 C 155 112, 155 118, 155 142" class="connector connector-right" marker-end="url(#sc-arrow)" />

        <text x="38" y="122" class="text-edge">{panel.left.label}</text>
        <text x="172" y="122" class="text-edge">{panel.right.label}</text>

        <rect x="10" y="146" width="90" height="46" rx="8" class="node-result node-keep" />
        <text x="55" y="169" class="text-result">{panel.left.result}</text>

        <rect x="110" y="146" width="90" height="46" rx="8" class="node-result node-eval" />
        <text x="155" y="169" class="text-result">{panel.right.result}</text>

        <text x="105" y="219" class="text-note">{panel.note}</text>
      </g>
    ))}

    <defs>
      <marker id="sc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-head" />
      </marker>
    </defs>
  </svg>
</div>

<style>
  .short-circuit-container {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    justify-content: center;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    box-sizing: border-box;
  }

  .short-circuit-svg {
    width: 100%;
    max-width: 690px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .panel {
    fill: none;
    stroke: var(--sl-color-gray-5, #94a3b8);
    stroke-width: 1.2;
    opacity: 0.8;
  }

  .text-operator {
    fill: var(--sl-color-text-accent, #38bdf8);
    font-size: 15px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .node-question {
    fill: rgba(56, 189, 248, 0.12);
    stroke: #38bdf8;
    stroke-width: 1.5;
  }

  .text-question {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 13px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .connector {
    fill: none;
    stroke: var(--sl-color-gray-4, #64748b);
    stroke-width: 1.8;
  }

  .arrow-head {
    fill: var(--sl-color-gray-4, #64748b);
  }

  .text-edge {
    fill: var(--sl-color-gray-3, #94a3b8);
    font-size: 12px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .node-result {
    stroke-width: 1.5;
  }

  .node-keep {
    fill: rgba(74, 222, 128, 0.12);
    stroke: #4ade80;
  }

  .node-eval {
    fill: rgba(192, 132, 252, 0.12);
    stroke: #c084fc;
  }

  .text-result {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 13px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-note {
    fill: var(--sl-color-gray-3, #94a3b8);
    font-size: 11px;
    text-anchor: middle;
    dominant-baseline: central;
  }
</style>
