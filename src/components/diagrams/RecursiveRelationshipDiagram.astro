---
/* Recorte DER de relacionamento recursivo. */
---

<figure class="recursive-relationship-diagram">
  <svg
    viewBox="0 0 620 300"
    class="recursive-relationship-diagram__svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Recorte conceitual de relacionamento recursivo entre disciplinas"
  >
    <path d="M 310 48 L 396 98 L 310 148 L 224 98 Z" class="relationship" />
    <text x="310" y="92" class="text-node">
      <tspan x="310" dy="0">TEM</tspan>
      <tspan x="310" dy="16">PRE-REQUISITO</tspan>
    </text>

    <rect x="246" y="204" width="128" height="54" rx="2" class="entity" />
    <text x="310" y="231" class="text-node">DISCIPLINA</text>

    <path d="M 256 126 C 182 160, 190 204, 246 220" class="connector" />
    <path d="M 364 126 C 438 160, 430 204, 374 220" class="connector" />

    <text x="178" y="172" class="text-cardinality">papel: disciplina atual</text>
    <text x="442" y="172" class="text-cardinality">papel: disciplina exigida</text>

  </svg>
  <figcaption>Recorte conceitual de relacionamento recursivo entre disciplinas.</figcaption>
</figure>

<style>
  .recursive-relationship-diagram {
    width: 100%;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    background: var(--sl-color-bg-inline-code, rgba(15, 23, 42, 0.3));
    border: 1px solid var(--sl-color-hairline-light, rgba(255, 255, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem 1rem 1rem;
    box-sizing: border-box;
  }

  .recursive-relationship-diagram__svg {
    width: 100%;
    max-width: 620px;
    height: auto;
    font-family: var(--sl-font-system, ui-sans-serif, system-ui, -apple-system, sans-serif);
  }

  .entity {
    fill: var(--sl-color-bg, #0f172a);
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .relationship {
    fill: rgba(56, 189, 248, 0.12);
    stroke: var(--sl-color-text-accent, #38bdf8);
    stroke-width: 1.7;
  }

  .connector {
    fill: none;
    stroke: var(--sl-color-gray-3, #94a3b8);
    stroke-width: 1.7;
  }

  .text-node,
  .text-cardinality,
  .text-note {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .text-node {
    fill: var(--sl-color-text, #f8fafc);
    font-size: 13px;
    font-weight: 800;
  }

  .text-cardinality,
  .text-note {
    fill: var(--sl-color-gray-2, #cbd5e1);
    font-size: 12px;
    font-weight: 700;
  }

  figcaption {
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
