---
/**
 * `<PackageManagerTabs>` — o mesmo comando nos tres gerenciadores.
 *
 * ```mdx
 * <PackageManagerTabs package="express" />
 * <PackageManagerTabs package="prisma" dev />
 * <PackageManagerTabs run="dev" />
 * <PackageManagerTabs exec="prisma init --datasource-provider sqlite" />
 * <PackageManagerTabs create="astro@latest" />
 * <PackageManagerTabs />
 * ```
 *
 * Usa o `<Tabs>` nativo do Starlight (com `syncKey`, a escolha do aluno vale
 * para o site inteiro) e o `<Code>` do Expressive Code em frame de terminal.
 */
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

interface Props {
  /** Pacote(s) a instalar, separados por espaco. */
  package?: string | undefined;
  /** Instala como dependencia de desenvolvimento. */
  dev?: boolean | undefined;
  /** Script do `package.json` a executar. */
  run?: string | undefined;
  /** Binario a executar sem instalar (npx / dlx). */
  exec?: string | undefined;
  /** Template de criacao de projeto. */
  create?: string | undefined;
  /** Chave de sincronizacao das abas. Padrao: `pkg`. */
  syncKey?: string | undefined;
}

const { package: pkg, dev = false, run, exec, create, syncKey = 'pkg' } = Astro.props;

const devFlag = dev ? ' -D' : '';

const managers = [
  {
    label: 'npm',
    install: pkg ? `npm install${devFlag} ${pkg}` : 'npm install',
    run: run ? `npm run ${run}` : undefined,
    exec: exec ? `npx ${exec}` : undefined,
    create: create ? `npm create ${create}` : undefined,
  },
  {
    label: 'pnpm',
    install: pkg ? `pnpm add${devFlag} ${pkg}` : 'pnpm install',
    run: run ? `pnpm ${run}` : undefined,
    exec: exec ? `pnpm dlx ${exec}` : undefined,
    create: create ? `pnpm create ${create}` : undefined,
  },
  {
    label: 'yarn',
    install: pkg ? `yarn add${devFlag} ${pkg}` : 'yarn install',
    run: run ? `yarn ${run}` : undefined,
    exec: exec ? `yarn dlx ${exec}` : undefined,
    create: create ? `yarn create ${create}` : undefined,
  },
];

const tabs = managers.map((manager) => ({
  label: manager.label,
  command: manager.create ?? manager.exec ?? manager.run ?? manager.install,
}));
---

<Tabs syncKey={syncKey}>
  {
    tabs.map((tab) => (
      <TabItem label={tab.label}>
        <Code code={tab.command} lang="bash" frame="terminal" />
      </TabItem>
    ))
  }
</Tabs>
