---
/**
 * `<ApiRequest>` — apresenta uma requisicao HTTP de forma didatica.
 *
 * ```mdx
 * <ApiRequest method="GET" path="/users/:id" />
 *
 * <ApiRequest method="POST" path="/users" description="Cria um usuario">
 * {`
 * {
 *   "name": "Ana"
 * }
 * `}
 * </ApiRequest>
 * ```
 *
 * As cores vem das variaveis semanticas do Starlight (via tokens `sl-*` do
 * Tailwind), entao o componente acompanha light e dark mode automaticamente.
 */
import { Code } from '@astrojs/starlight/components';
import { slotHtmlToText } from '../lib/slot-text';

interface Props {
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE' | 'HEAD' | 'OPTIONS';
  path: string;
  /** Texto curto explicando a requisicao. */
  description?: string | undefined;
  /** Prefixo exibido antes do caminho, ex.: `http://localhost:3000`. */
  baseUrl?: string | undefined;
  /** Linguagem do corpo da requisicao. Padrao: `json`. */
  lang?: string | undefined;
}

/**
 * Cada metodo usa o par `-low` (fundo) + `-high` (texto) do Starlight.
 * As cores solidas (`bg-sl-green`, por exemplo) sao claras demais para texto
 * branco no tema escuro — o contraste ficava em 1.46:1, abaixo do minimo 4.5:1
 * da WCAG AA. O par low/high passa de 6:1 nos dois temas.
 */
const METHOD_CLASSES: Record<string, string> = {
  GET: 'bg-sl-blue-low text-sl-blue-high',
  POST: 'bg-sl-green-low text-sl-green-high',
  PUT: 'bg-sl-orange-low text-sl-orange-high',
  PATCH: 'bg-sl-orange-low text-sl-orange-high',
  DELETE: 'bg-sl-red-low text-sl-red-high',
};

const { method, path, description, baseUrl, lang = 'json' } = Astro.props;

const rawBody = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const body = slotHtmlToText(rawBody);
const badgeClasses = METHOD_CLASSES[method] ?? 'bg-sl-gray-5 text-sl-white';
---

<div class="api-exchange not-content my-4 overflow-hidden rounded-lg border border-sl-gray-5 bg-sl-black">
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-sl-gray-5 bg-sl-gray-6 px-3.5 py-2.5"
  >
    <span
      class:list={[
        'shrink-0 rounded px-2 py-0.5 font-mono text-sl-xs font-semibold tracking-wide',
        badgeClasses,
      ]}
    >
      {method}
    </span>
    <code class="border-none bg-transparent p-0 font-mono text-sl-sm break-words text-sl-white">
      {baseUrl && <span class="text-sl-gray-2">{baseUrl}</span>}{path}
    </code>
  </div>

  {
    description && (
      <p class="m-0 px-3.5 py-2.5 text-sl-sm text-sl-gray-2 [&+.api-exchange__body]:border-t [&+.api-exchange__body]:border-sl-gray-5">
        {description}
      </p>
    )
  }

  {
    body && (
      <div class="api-exchange__body">
        <Code code={body} lang={lang} frame="none" />
      </div>
    )
  }
</div>

<style>
  @layer starlight.components {
    /* O bloco do Expressive Code encosta nas bordas do cartao. */
    .api-exchange :global(.expressive-code) {
      margin: 0;
    }

    .api-exchange :global(.expressive-code pre) {
      border: none;
      border-radius: 0;
    }
  }
</style>
