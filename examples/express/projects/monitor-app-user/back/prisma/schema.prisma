// Documentacao do schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  hosts     Host[]
}

model Host {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  // O dono do host. `Cascade` remove os hosts junto com a conta.
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  // Um-para-muitos: cada medicao pertence a um host, e o host acumula o historico.
  pings     Ping[]
  // Muitos-para-muitos: o Prisma cria a tabela de juncao sozinho.
  tags      Tag[]    @relation("HostTags")
}

model Ping {
  id        String   @id @default(uuid())
  // Nulo quando o host nao respondeu: a medicao existe, a latencia nao.
  latency   Int?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId    String
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String
  hosts Host[] @relation("HostTags")
}
