@server = http://localhost:3000
@token = {{signin.response.body.$.token}}

### Cadastro publico
# @name signup
POST {{server}}/auth/signup
Content-Type: application/json

{
  "name": "Bruno",
  "email": "bruno@example.com",
  "password": "senha-secreta"
}

### Cadastro com senha curta (400)
POST {{server}}/auth/signup
Content-Type: application/json

{
  "name": "Curto",
  "email": "curto@example.com",
  "password": "1234"
}

### E-mail duplicado (409)
POST {{server}}/auth/signup
Content-Type: application/json

{
  "name": "Ana de novo",
  "email": "ana@example.com",
  "password": "senha-secreta"
}

### Login — guarda o token para as proximas requisicoes
# @name signin
POST {{server}}/auth/signin
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "senha-secreta"
}

### Senha errada (401)
POST {{server}}/auth/signin
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "errada"
}

### Perfil do usuario autenticado
GET {{server}}/auth/me
Authorization: Bearer {{token}}

### Sem token (401)
GET {{server}}/investments

### Cria um investimento do usuario autenticado
# @name createInvestment
POST {{server}}/investments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Tesouro Selic 2029",
  "amount": 20000
}

### Lista apenas os investimentos do usuario autenticado
GET {{server}}/investments
Authorization: Bearer {{token}}

### Remove um investimento proprio
DELETE {{server}}/investments/{{createInvestment.response.body.$.id}}
Authorization: Bearer {{token}}

### Rota administrativa (403 para role "user")
GET {{server}}/users
Authorization: Bearer {{token}}
