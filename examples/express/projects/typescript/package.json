{
  "name": "express-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API Express em TypeScript organizada em camadas",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
