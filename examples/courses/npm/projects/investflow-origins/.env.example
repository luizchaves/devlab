# Valores da stack local (supabase start). Os dois sao publicos: vao para o bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key exibida por supabase status>

# Usada SOMENTE pelos testes de integracao, para ler entre contas e provar o isolamento.
# Nunca importada por src/. Sem o prefixo VITE_, o Vite nao a coloca no bundle.
SUPABASE_SERVICE_ROLE_KEY=<service_role key exibida por supabase status>

# Segredos da Edge Function ficam em supabase/functions/.env (local) ou em
# `supabase secrets set` (nuvem). NUNCA aqui: este arquivo alimenta o Vite.
# MARKET_PROVIDER=fake | yahoo | brapi
# MARKET_API_TOKEN=<token, so para brapi>
