// Documentação do schema: https://pris.ly/d/prisma-schema

// O gerador `prisma-client` (Prisma 7) emite TypeScript em ESM dentro de `src/`;
// o código importa de `@/generated/prisma/client`, e não de `@prisma/client`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Extensão explícita: o Node executa `prisma/seed.ts` sem bundler.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Papel do usuário: o vanilla guarda em `profiles.role`; aqui vive no próprio
// usuário, porque o NextAuth não separa conta de perfil.
enum Role {
  INVESTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(INVESTOR)
  avatarPath   String?
  createdAt    DateTime @default(now())
  brokers      Broker[]
  assets       Asset[]
  transactions Transaction[]
}

// As categorias, moedas e tipos de lançamento têm os mesmos valores do
// InvestFlow vanilla (`check (category in (...))`), agora como enums.
enum AssetCategory {
  renda_fixa
  acoes
  fiis
  etfs
  fi_infra
  fundos
  cripto
}

enum Currency {
  BRL
  USD
}

enum TransactionType {
  buy
  sell
  update
}

// A corretora nasce quando um ativo a cita pela primeira vez; única por dono.
model Broker {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@unique([userId, name])
}

model Asset {
  id           String        @id @default(cuid())
  userId       String
  brokerId     String?
  ticker       String
  name         String
  category     AssetCategory
  issuer       String?
  currency     Currency      @default(BRL)
  // Última cotação conhecida; nula para ativos por saldo (renda fixa, fundos).
  currentPrice Decimal?      @db.Decimal(14, 4)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker       Broker?       @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([userId, ticker])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  assetId         String
  type            TransactionType
  quantity        Decimal         @db.Decimal(18, 8)
  price           Decimal         @db.Decimal(14, 4)
  transactionDate DateTime        @db.Date
  receiptPath     String?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, transactionDate])
}
