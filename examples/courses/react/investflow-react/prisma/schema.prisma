// Documentação do schema: https://pris.ly/d/prisma-schema

// O gerador `prisma-client` (Prisma 7) emite TypeScript em ESM dentro de `src/`;
// o código importa de `@/generated/prisma/client`, e não de `@prisma/client`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Extensão explícita: o Node executa `prisma/seed.ts` sem bundler.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Papel do usuário: o vanilla guarda em `profiles.role`; aqui vive no próprio
// usuário, porque o NextAuth não separa conta de perfil.
enum Role {
  INVESTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(INVESTOR)
  avatarPath   String?
  createdAt    DateTime @default(now())
}
