# PostgreSQL da stack local do Supabase (`supabase start`; portas 5434x deste projeto).
# Os testes usam o mesmo banco em schemas separados (`?schema=integration`, `?schema=e2e`).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54342/postgres?schema=public"

# Supabase Storage (comprovantes e avatares). A service role fica SÓ no servidor.
SUPABASE_URL="http://127.0.0.1:54341"
SUPABASE_SERVICE_ROLE_KEY="<service_role key exibida por supabase status>"

# Segredo que assina o JWT de sessão do NextAuth. Troque em produção.
AUTH_SECRET="change-me-in-development"
AUTH_URL="http://localhost:3000"

# Provedor de cotações: `fake` (testes), `yahoo` (gratuito, sem token).
QUOTES_PROVIDER="fake"
