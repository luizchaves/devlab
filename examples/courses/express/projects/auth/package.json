{
  "name": "express-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cadastro, autenticacao com JWT e autorizacao usando apenas node:crypto",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
