{
  "name": "invest-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "NODE_ENV=test EMAIL_HOST= node --env-file=.env --import tsx --test \"src/**/*.test.ts\"",
    "coverage": "NODE_ENV=test EMAIL_HOST= node --env-file=.env --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=60 \"src/**/*.test.ts\"",
    "front:test": "vitest run public/js",
    "e2e": "playwright test",
    "front:coverage": "vitest run public/js --coverage",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "prisma": "^7.10.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
