{
  "name": "invest-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "build": "vite build",
    "css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/app.css",
    "css:watch": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/app.css --watch",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "morgan": "^1.12.0",
    "prisma": "^7.10.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
