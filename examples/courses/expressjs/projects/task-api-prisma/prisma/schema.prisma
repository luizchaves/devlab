// Documentacao do schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String?
  done        Boolean  @default(false)
  priority    String   @default("medium")
  dueDate     String?
  createdAt   DateTime @default(now())
  // Muitos-para-muitos: o Prisma cria a tabela de juncao sozinho.
  tags        Tag[]    @relation("TaskTags")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String
  tasks Task[] @relation("TaskTags")
}
