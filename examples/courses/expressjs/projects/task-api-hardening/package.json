{
  "name": "task-api-hardening",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Etapa 10 da TaskAPI: configuracao validada, log estruturado, metricas, CORS e endurecimento",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.5.4",
    "swagger-ui-express": "^5.0.1",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "@types/swagger-ui-express": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "better-sqlite3"
    ]
  }
}
