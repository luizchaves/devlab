NODE_ENV=development
PORT=3000

DATABASE_URL="file:./prisma/dev.db"

# Minimo de 32 caracteres. Gere o seu com: openssl rand -hex 32
JWT_SECRET="troque-este-segredo-de-desenvolvimento-com-32-chars"
JWT_EXPIRES_IN=3600

# Origens autorizadas a ler as respostas, separadas por virgula.
CORS_ORIGINS="http://localhost:5173"

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info

APP_URL="http://localhost:3000"

# Sem SMTP_HOST, o Nodemailer usa o transporte de teste e nada e enviado.
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="TaskAPI <nao-responda@task-api.local>"
