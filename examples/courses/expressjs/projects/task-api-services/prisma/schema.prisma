// Documentacao do schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  // Guarda o hash Argon2id, nunca a senha em claro.
  password  String
  role      String   @default("user")
  // Caminho do avatar enviado pelo upload; nulo enquanto nao houver.
  avatar    String?
  // Nulo depois que o usuario confirma o e-mail.
  verifyToken String?
  verifiedAt  DateTime?
  createdAt DateTime @default(now())
  // O usuario sai, as tarefas dele saem junto.
  tasks     Task[]
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  done        Boolean  @default(false)
  priority    String   @default("medium")
  dueDate     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  // Muitos-para-muitos: o Prisma cria a tabela de juncao sozinho.
  tags        Tag[]    @relation("TaskTags")

  // O titulo e unico por dono, e nao no sistema inteiro.
  @@unique([userId, title])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String
  tasks Task[] @relation("TaskTags")
}
