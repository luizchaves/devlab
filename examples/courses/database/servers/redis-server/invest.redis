# ==============================================================================
# Redis: Operações de Chave-Valor e Estruturas de Dados no Domínio InvestApp
# ==============================================================================

# 1. Strings: Cache de cotação e contador de acessos
SET quote:cdb "13.65" EX 60
GET quote:cdb
INCR pageviews:investments:cdb
GET pageviews:investments:cdb

# 2. Hashes: Objeto estruturado de investimento
HSET investment:1 name "CDB Prefixado 12%" value "5000.00" category "Renda Fixa" broker "XP"
HSET investment:2 name "Tesouro Selic 2029" value "8500.00" category "Pós-fixado" broker "NuInvest"
HGETALL investment:1
HGET investment:1 value
HINCRBYFLOAT investment:1 value 500.00
HGET investment:1 value

# 3. Lists: Log de transações recentes (fila/histórico)
LPUSH user:1:transactions "DEPOSIT: 1000.00"
LPUSH user:1:transactions "BUY: CDB 500.00"
LPUSH user:1:transactions "BUY: Tesouro 500.00"
LRANGE user:1:transactions 0 -1
LTRIM user:1:transactions 0 9

# 4. Sets: Categorias e tags únicas
SADD categories "Renda Fixa" "Pós-fixado" "Ações" "FIIs"
SMEMBERS categories
SISMEMBER categories "Cripto"

# 5. Sorted Sets (ZSet): Ranking e Leaderboard por patrimônio ou rentabilidade
ZADD leaderboard:investors 14000.00 "user:lucas" 8500.00 "user:ana" 22000.00 "user:carla"
ZREVRANGE leaderboard:investors 0 -1 WITHSCORES
ZREVRANK leaderboard:investors "user:lucas"

# 6. Expiração (TTL) e Rate Limiting
SETEX rate_limit:user:1:api 60 1
TTL rate_limit:user:1:api
